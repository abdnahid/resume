# ── Database ──
DATABASE_URL='postgresql://user:password@host:5432/bsti'

# ── Auth (better-auth) ──
BETTER_AUTH_SECRET='generate-with: openssl rand -base64 32'
BETTER_AUTH_URL='http://localhost:3000'

# ── PDF rendering (optional) ──
# Only needed when puppeteer's own Chromium was not downloaded at install time.
# `lib/pdf.ts` finds a system Chrome on its own; set this to force a binary.
# PUPPETEER_EXECUTABLE_PATH='/usr/bin/google-chrome'

# ── Payments ──
# Which gateway processes money. Defaults to the built-in sandbox, which needs
# no keys and no network — nothing is charged and no card or wallet is
# contacted. The real gateway question (spec §6 — is Sonali Bank legally
# mandatory, or may an aggregator sit in front of it?) is still open, so the
# safe default is the one that cannot move money.
# PAYMENT_PROVIDER='sandbox'
