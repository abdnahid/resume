// ─── Bank Advice ──────────────────────────────────────────────────────────────

/// One office's salary advice to the bank for one month.
///
/// Per office, not per institute: each office pays its own staff on its own
/// cheque, and the letter names that office. A single national row could not
/// represent that — the two legacy rows were labelled Dhaka while totalling
/// every office's staff.
///
/// Once an advice exists for a month, that office's salary for it can no longer
/// be deleted and re-processed, so the stored totals and the entries computed
/// from `SalaryProcess` cannot drift apart.
model BankAdvice {
  id            Int      @id @default(autoincrement())
  memoNo        String
  month         String
  year          String
  chequeNo      String
  chequeDate    String
  depositDate   String
  totalAmount   Int
  totalInWords  String
  employeeCount Int
  createdAt     DateTime @default(now())

  /// Nullable only so the two pre-existing rows could be migrated. Every advice
  /// written from now on carries an office — the routes require it.
  officeId Int?
  office   Office? @relation(fields: [officeId], references: [id])

  /// The bank block as it stood when the letter was issued. Snapshotted because
  /// an advice is a record of what was sent — re-rendering an old letter with a
  /// branch that changed since would misstate it. Null on advices issued before
  /// office bank details existed; those fall back to the office's current ones.
  bankNameBn             String?
  branchNameBn           String?
  branchAddressBn        String?
  recipientDesignationBn String?
  drawnOnAccountNo       String?

  @@unique([month, year, officeId])
}

