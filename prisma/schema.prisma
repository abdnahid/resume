generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrgCategory {
  wing
  divisional
  regional
  unit
}

enum PostingStatus {
  pending
  active
}

enum PostingType {
  initial
  transfer
  promotion
  demotion
  deputation
  lien
}

enum Role {
  superadmin
  officeadmin
  data_entry
  employee
}

enum OfficeType {
  head
  divisional
  district
  regional
  dmi
}

enum EmployeeStatus {
  active
  retired
  prl
  inactive
}

enum SalaryStatus {
  active
  expired
  not_found
  inactive
}

enum IdCardBatchStatus {
  pending
  issued
}

enum IdCardStatus {
  pending
  active
  superseded
}

enum Gender {
  male
  female
  other
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
}

enum BloodGroup {
  A_pos
  A_neg
  B_pos
  B_neg
  AB_pos
  AB_neg
  O_pos
  O_neg
}

enum WorkHistoryType {
  bsti
  previous
}

// ─── Organogram ──────────────────────────────────────────────────────────────

model OrgUnit {
  id        Int         @id @default(autoincrement())
  slug      String      @unique
  nameEn    String
  nameBn    String
  category  OrgCategory @default(unit)
  parentId  Int?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitTree")
  posts    OrgPost[]
}

model OrgPost {
  id              Int      @id @default(autoincrement())
  nameEn          String
  nameBn          String
  grade           String?
  sanctionedCount Int      @default(1)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unitId    Int
  unit      OrgUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employees Employee[]
  postings  Posting[]
}

model Posting {
  id           Int           @id @default(autoincrement())
  type         PostingType   @default(initial)
  status       PostingStatus @default(active)
  grade        String
  joinedAt     String?
  relievedAt   String?
  orderNo      String?
  orderDate    String?
  remarks      String?
  selfReported Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  orgPostId  Int?
  orgPost    OrgPost? @relation(fields: [orgPostId], references: [id])

  officeId   Int
  office     Office   @relation(fields: [officeId], references: [id])
}

// ─── better-auth tables ───────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  username      String    @unique
  role          Role      @default(employee)

  sessions  Session[]
  accounts  Account[]
  employee  Employee?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ─── Office ───────────────────────────────────────────────────────────────────

model Office {
  id         Int        @id
  type       OfficeType
  nameEn     String
  nameBn     String
  officeHead String
  addressEn  String
  addressBn  String
  phone      String?
  email      String?

  employees Employee[]
  postings  Posting[]
}

// ─── Address ──────────────────────────────────────────────────────────────────

model Address {
  id           Int     @id @default(autoincrement())
  division     String?
  district     String?
  upazila      String?
  cityCorpType String? // "cityCorp" | "pourosova" | "union"
  cityCorpName String?
  ward         String?
  houseNo      String?
  road         String?
  postOffice   String?
  postCode     String?
  thana        String?
  village      String? // legacy field — kept for backward compat

  presentOf   Employee? @relation("PresentAddress")
  permanentOf Employee? @relation("PermanentAddress")
}

// ─── Employee ─────────────────────────────────────────────────────────────────

model Employee {
  id     String         @id
  status EmployeeStatus @default(active)

  // Identity
  nameEn       String
  nameBn       String
  fatherNameEn String
  fatherNameBn String
  motherNameEn String
  motherNameBn String
  dateOfBirth  String
  gender       Gender
  maritalStatus MaritalStatus
  bloodGroup   BloodGroup?
  nid           String?
  passportNo    String?
  nationality   String?
  placeOfBirth  String?
  signatureLabel String?
  photoLabel    String?
  wing          String?

  // Contact
  email        String?
  mobileHome   String?
  mobileOffice String?
  phone        String?

  // Emergency contact (embedded)
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  emergencyMobile   String?

  // Bank details
  bankAccountNo String?
  bankBranch    String?
  tinNo         String?

  // Current job — nullable during Posting migration; derive from active Posting going forward
  designationEn         String?
  designationBn         String?
  grade                 String?
  division              String?
  initialDesignationBn  String?
  dateOfJoining         String?
  postRetirementLeave   String?
  fullRetirement        String?

  // Profile self-reporting control
  serviceHistoryLocked Boolean @default(false)

  // Profile approval workflow
  profileStatus       String    @default("draft") // draft | submitted | approved | needs_revision
  profileSubmittedAt  DateTime?
  profileApprovedAt   DateTime?
  profileApprovedBy   String?
  profileRevisionNote String?

  // Relations
  orgPostId         Int?
  orgPost           OrgPost? @relation(fields: [orgPostId], references: [id])
  postings          Posting[]

  officeId          Int
  office            Office  @relation(fields: [officeId], references: [id])

  presentAddressId  Int?    @unique
  presentAddress    Address? @relation("PresentAddress", fields: [presentAddressId], references: [id])

  permanentAddressId Int?   @unique
  permanentAddress   Address? @relation("PermanentAddress", fields: [permanentAddressId], references: [id])

  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sub-tables
  fixation            SalaryFixation?
  salaryHistory       SalaryHistory[]
  salaryProcesses     SalaryProcess[]
  workHistory         WorkHistory[]
  educations          Education[]
  promotions          Promotion[]
  trainings           Training[]
  foreignTrainings    ForeignTraining[]
  publications        Publication[]
  awards              Award[]
  idCards             IdCard[]

  // New profile sub-tables
  spouse              Spouse?
  children            Child[]
  languages           Language[]
  curriculars         Curricular[]
  disciplinaryActions DisciplinaryAction[]
}

// ─── Salary Fixation ─────────────────────────────────────────────────────────

model SalaryFixation {
  id           Int          @id @default(autoincrement())
  grade        Int
  basicSalary  Int
  validFrom    String
  validThru    String
  salaryStatus SalaryStatus @default(active)

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Salary History ───────────────────────────────────────────────────────────

model SalaryHistory {
  id    Int @id @default(autoincrement())
  sl    Int
  grade Int
  basic Int
  month String
  year  String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Salary Process ───────────────────────────────────────────────────────────

model SalaryProcess {
  id        Int    @id @default(autoincrement())
  netSalary Int
  issueDate String
  month     String
  year      String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

// ─── Work History ─────────────────────────────────────────────────────────────

model WorkHistory {
  id            Int             @id @default(autoincrement())
  sl            Int
  type          WorkHistoryType @default(bsti)
  designationBn String
  designationEn String
  grade         String
  office        String
  start         String
  end           String
  orderNo       String?
  orderDate     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Education ────────────────────────────────────────────────────────────────

model Education {
  id          Int    @id @default(autoincrement())
  sl          Int
  degree      String
  subject     String?
  institution String
  board       String?
  passingYear String
  result      String?
  gpa         String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Promotion ────────────────────────────────────────────────────────────────

model Promotion {
  id              Int    @id @default(autoincrement())
  sl              Int
  designationBn   String
  designationEn   String
  grade           String
  effectiveDate   String
  orderNo         String?
  orderDate       String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Training ─────────────────────────────────────────────────────────────────

model Training {
  id           Int    @id @default(autoincrement())
  sl           Int
  title        String
  institution  String?
  duration     String?
  year         String?
  result       String?
  startDate    String?
  endDate      String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Foreign Training ─────────────────────────────────────────────────────────

model ForeignTraining {
  id          Int    @id @default(autoincrement())
  sl          Int
  title       String
  country     String?
  institution String?
  duration    String?
  year        String?
  result      String?
  startDate   String?
  endDate     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Publication ──────────────────────────────────────────────────────────────

model Publication {
  id          Int    @id @default(autoincrement())
  sl          Int
  type        String?
  title       String
  publisher   String?
  writers     String?
  year        String?
  description String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Award ────────────────────────────────────────────────────────────────────

model Award {
  id        Int    @id @default(autoincrement())
  sl        Int
  type      String?
  title     String
  awardedBy String?
  country   String?
  subject   String?
  reason    String?
  year      String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Bank Advice ──────────────────────────────────────────────────────────────

model BankAdvice {
  id            Int      @id @default(autoincrement())
  memoNo        String
  month         String
  year          String
  chequeNo      String
  chequeDate    String
  depositDate   String
  totalAmount   Int
  totalInWords  String
  employeeCount Int
  createdAt     DateTime @default(now())

  @@unique([month, year])
}

// ─── Director General ──────────────────────────────────────────────────────────

model DirectorGeneral {
  id           Int      @id @default(autoincrement())
  nameEn       String
  nameBn       String
  signatureUrl String?
  photoUrl     String?
  appointedAt  String
  relievedAt   String?
  orderNo      String?
  orderDate    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorizations IdCardBatch[]
}

// ─── ID Card Authorization ────────────────────────────────────────────────────

model IdCardBatch {
  id          Int               @id @default(autoincrement())
  memoNo      String?
  status      IdCardBatchStatus @default(pending)
  requestedAt String
  signedDate  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  directorGeneralId Int
  directorGeneral   DirectorGeneral @relation(fields: [directorGeneralId], references: [id])

  cards IdCard[]
}

model IdCard {
  id        Int          @id @default(autoincrement())
  version   Int          @default(1)
  status    IdCardStatus @default(pending)
  issueDate String?
  createdAt DateTime     @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  batchId Int
  batch   IdCardBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// ─── Spouse ───────────────────────────────────────────────────────────────────

model Spouse {
  id                   Int         @id @default(autoincrement())
  nid                  String?
  mobile               String?
  nameBn               String?
  nameEn               String?
  motherNameBn         String?
  motherNameEn         String?
  fatherNameBn         String?
  fatherNameEn         String?
  dateOfBirth          String?
  occupation           String?
  bloodGroup           BloodGroup?
  nationality          String?
  passportNo           String?
  passportReceivePlace String?
  passportReceiveDate  String?
  passportIssueDate    String?
  passportExpiryDate   String?

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Child ────────────────────────────────────────────────────────────────────

model Child {
  id          Int         @id @default(autoincrement())
  sl          Int
  nameBn      String?
  nameEn      String?
  dateOfBirth String?
  bloodGroup  BloodGroup?
  brn         String?
  nid         String?
  gender      Gender?
  isSpecial   Boolean     @default(false)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Language ─────────────────────────────────────────────────────────────────

model Language {
  id          Int    @id @default(autoincrement())
  sl          Int
  name        String
  proficiency String? // "good" | "better" | "best"
  comment     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Curricular ───────────────────────────────────────────────────────────────

model Curricular {
  id      Int    @id @default(autoincrement())
  sl      Int
  type    String
  comment String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Disciplinary Action ──────────────────────────────────────────────────────

model DisciplinaryAction {
  id          Int    @id @default(autoincrement())
  sl          Int
  type        String // "departmental" | "criminal" | "acc"
  reason      String?
  description String?
  startDate   String?
  endDate     String?
  comment     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
