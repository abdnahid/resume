generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrgCategory {
  wing
  divisional
  regional
  unit
}

enum PostingStatus {
  pending
  active
}

enum PostingType {
  initial
  transfer
  promotion
  demotion
  deputation
  lien
}

enum Role {
  superadmin
  officeadmin
  data_entry
  /// Handles court and departmental cases for staff across every office, and is
  /// the only role besides superadmin that may record a verdict. Carries no
  /// other administrative power.
  case_officer
  employee
  /// Inert. Clients are gated by `accountType`, not by role — this exists so a
  /// client row never reads as `employee` and trips an internal role check.
  client
}

/// Which side of the platform an account belongs to.
/// INTERNAL = BSTI staff (employee ID login, may reach internal modules).
/// CLIENT   = the public (mobile or email login, client surfaces only).
/// Defaults to INTERNAL so every pre-existing employee row stays correct.
enum AccountType {
  INTERNAL
  CLIENT
}

enum OfficeType {
  head
  divisional
  district
  regional
  dmi
}

enum EmployeeStatus {
  active
  retired
  prl
  inactive
}

enum SalaryStatus {
  active
  expired
  not_found
  inactive
}

/// Which side of a salary sheet a head sits on.
enum SalaryHeadKind {
  earning
  deduction
}

/// How a head's amount is worked out at fixation time.
enum SalaryHeadBasis {
  /// A taka amount, taken from the head's default or overridden per employee.
  fixed
  /// A whole percent of the fixation's basic salary.
  percent_of_basic
  /// The government slab table — a percent of basic with a floor, chosen by the
  /// employee's office zone. See `HouseRentRule`.
  house_rent_rule
}

/// Why a fixation version was raised. Every version records one, so the reason
/// an employee's pay changed mid-year is on the record rather than in a note.
enum FixationReason {
  /// The 1 July fiscal-year fixation — the ordinary case.
  annual
  initial
  increment
  promotion
  punishment
  correction
}

/// Where a case is being heard.
enum CaseForum {
  departmental
  administrative_tribunal
  civil_court
  criminal_court
  high_court
  appellate_division
}

enum CaseStatus {
  open
  under_trial
  verdict_given
  under_appeal
  closed
}

/// What a verdict does to an employee's pay. Every clause is applied by
/// `applyVerdict()` in `lib/salary/compute.ts`, in the fixed order documented
/// there — order matters, since a demotion changes which grid a step reads.
enum VerdictClauseType {
  /// Move down `value` increments on the same grade. Floors at the initial step.
  reduce_increments
  /// Stay on the current step for `value` more annual fixations.
  withhold_increment
  /// Resolve basic from grade `value` instead of the substantive grade.
  demote_grade
  /// Pay `value`% of the scale basic — 50 for a half salary.
  basic_percent
  /// Every allowance falls away; deductions and basic stand.
  suppress_allowances
  /// One named head falls away. `headId` says which.
  suppress_head
}

/// Zones of the government's monthly house rent rate table.
/// Source: `utils/rent.xlsx`.
enum HouseRentZone {
  dhaka
  /// Chittagong, Khulna, Rajshahi, Sylhet, Barisal, Rangpur, Gazipur,
  /// Narayanganj — the table names these eight explicitly.
  divisional_city
  other_district
}

enum IdCardBatchStatus {
  pending
  issued
}

enum IdCardStatus {
  pending
  active
  superseded
}

enum Gender {
  male
  female
  other
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
}

enum BloodGroup {
  A_pos
  A_neg
  B_pos
  B_neg
  AB_pos
  AB_neg
  O_pos
  O_neg
}

enum WorkHistoryType {
  bsti
  previous
}

// ─── Organogram ──────────────────────────────────────────────────────────────

model OrgUnit {
  id        Int         @id @default(autoincrement())
  slug      String      @unique
  nameEn    String
  nameBn    String
  category  OrgCategory @default(unit)
  parentId  Int?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitTree")
  posts    OrgPost[]
}

model OrgPost {
  id              Int      @id @default(autoincrement())
  nameEn          String
  nameBn          String
  grade           String?
  sanctionedCount Int      @default(1)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unitId    Int
  unit      OrgUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employees Employee[]
  postings  Posting[]
}

model Posting {
  id           Int           @id @default(autoincrement())
  type         PostingType   @default(initial)
  status       PostingStatus @default(active)
  grade        String
  joinedAt     String?
  relievedAt   String?
  orderNo      String?
  orderDate    String?
  remarks      String?
  selfReported Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  orgPostId Int?
  orgPost   OrgPost? @relation(fields: [orgPostId], references: [id])

  officeId Int
  office   Office @relation(fields: [officeId], references: [id])
}

// ─── better-auth tables ───────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  /// Optional: a mobile-only client has no real email. better-auth's sign-up
  /// endpoint still demands one, so those rows carry a synthesised placeholder
  /// (see `lib/auth-identity.ts`) which is replaced if the client adds a real
  /// address later.
  email         String?  @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  /// Employee ID for INTERNAL accounts. Null for clients — they are keyed on
  /// `mobile` instead, which keeps an 11-digit mobile from ever colliding with
  /// an 11-digit employee ID.
  username      String?  @unique
  role          Role     @default(employee)

  accountType AccountType @default(INTERNAL)

  /// better-auth's phone-number plugin is mapped onto these two columns.
  mobile           String?   @unique
  mobileVerified   Boolean   @default(false)
  /// §2.6 — present and nullable from day one so OTP drops in without a migration.
  mobileVerifiedAt DateTime?

  sessions Session[]
  accounts Account[]
  employee Employee?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ─── Office ───────────────────────────────────────────────────────────────────

model Office {
  id            Int            @id
  type          OfficeType
  nameEn        String
  nameBn        String
  /// Which column of the government house rent table this office falls in.
  /// Null means unclassified — house rent cannot be computed for its staff
  /// until someone sets it. See `npm run seed:salary`.
  houseRentZone HouseRentZone?
  officeHead    String
  addressEn     String
  addressBn     String
  phone         String?
  email         String?

  employees   Employee[]
  postings    Posting[]
  bankAdvices BankAdvice[]
}

// ─── Address ──────────────────────────────────────────────────────────────────

model Address {
  id           Int     @id @default(autoincrement())
  division     String?
  district     String?
  upazila      String?
  cityCorpType String? // "cityCorp" | "pourosova" | "union"
  cityCorpName String?
  ward         String?
  houseNo      String?
  road         String?
  postOffice   String?
  postCode     String?
  thana        String?
  village      String? // legacy field — kept for backward compat

  presentOf   Employee? @relation("PresentAddress")
  permanentOf Employee? @relation("PermanentAddress")
}

// ─── Employee ─────────────────────────────────────────────────────────────────

model Employee {
  id     String         @id
  status EmployeeStatus @default(active)

  // Identity
  nameEn         String
  nameBn         String
  fatherNameEn   String
  fatherNameBn   String
  motherNameEn   String
  motherNameBn   String
  dateOfBirth    String
  gender         Gender
  maritalStatus  MaritalStatus
  bloodGroup     BloodGroup?
  nid            String?
  passportNo     String?
  nationality    String?
  placeOfBirth   String?
  signatureLabel String?
  photoLabel     String?
  wing           String?

  // Contact
  email        String?
  mobileHome   String?
  mobileOffice String?
  phone        String?

  // Emergency contact (embedded)
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  emergencyMobile   String?

  // Bank details
  bankAccountNo String?
  bankBranch    String?
  tinNo         String?

  // Current job — nullable during Posting migration; derive from active Posting going forward
  designationEn        String?
  designationBn        String?
  grade                String?
  division             String?
  initialDesignationBn String?
  dateOfJoining        String?
  postRetirementLeave  String?
  fullRetirement       String?

  // Profile self-reporting control
  serviceHistoryLocked Boolean @default(false)

  // Profile approval workflow
  profileStatus       String    @default("draft") // draft | submitted | approved | needs_revision
  profileSubmittedAt  DateTime?
  profileApprovedAt   DateTime?
  profileApprovedBy   String?
  profileRevisionNote String?

  // Relations
  orgPostId Int?
  orgPost   OrgPost?  @relation(fields: [orgPostId], references: [id])
  postings  Posting[]

  officeId Int
  office   Office @relation(fields: [officeId], references: [id])

  presentAddressId Int?     @unique
  presentAddress   Address? @relation("PresentAddress", fields: [presentAddressId], references: [id])

  permanentAddressId Int?     @unique
  permanentAddress   Address? @relation("PermanentAddress", fields: [permanentAddressId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sub-tables
  fixations        SalaryFixation[]
  cases            EmployeeCase[]
  arrears          SalaryArrear[]
  salaryHistory    SalaryHistory[]
  salaryProcesses  SalaryProcess[]
  workHistory      WorkHistory[]
  educations       Education[]
  promotions       Promotion[]
  trainings        Training[]
  foreignTrainings ForeignTraining[]
  publications     Publication[]
  awards           Award[]
  idCards          IdCard[]

  // New profile sub-tables
  spouse              Spouse?
  children            Child[]
  languages           Language[]
  curriculars         Curricular[]
  disciplinaryActions DisciplinaryAction[]
}

// ─── Pay scale (versioned) ───────────────────────────────────────────────────

/// A national pay scale. NPS-2015 is the one in force; when a new scale is
/// gazetted it arrives as another row and nothing here is ever deleted — a
/// fixation made in 2019 has to keep resolving against the scale it was made
/// under, or the salary history stops reconciling.
model PayScale {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  nameEn        String
  nameBn        String
  effectiveFrom String
  effectiveTo   String?
  /// The scale new fixations default to. Exactly one row should carry this.
  isActive      Boolean  @default(false)
  /// False until the step amounts have been loaded from the gazette and
  /// checked. Fixation refuses to derive a basic salary from an unverified
  /// scale and falls back to manual entry — see `lib/salary/compute.ts`.
  verified      Boolean  @default(false)
  incrementNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps          PayScaleStep[]
  houseRentRules HouseRentRule[]
  fixations      SalaryFixation[]

  @@index([isActive])
}

/// One cell of the scale grid: what grade G pays at step S.
/// Step 0 is the grade's initial basic; each further step is one annual
/// increment.
model PayScaleStep {
  id     Int @id @default(autoincrement())
  grade  Int
  step   Int
  amount Int

  scaleId Int
  scale   PayScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, grade, step])
  @@index([scaleId, grade])
}

/// The government's monthly house rent slabs, keyed to the scale version they
/// were published alongside. A percent of basic, floored at `minAmount`.
/// Source: `utils/rent.xlsx`.
model HouseRentRule {
  id        Int           @id @default(autoincrement())
  zone      HouseRentZone
  minBasic  Int
  /// Null means the open-ended top slab ("35501 and above").
  maxBasic  Int?
  percent   Int
  minAmount Int

  scaleId Int
  scale   PayScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, zone, minBasic])
  @@index([scaleId, zone])
}

// ─── Salary heads ────────────────────────────────────────────────────────────

/// An allowance or deduction that can be attached to a fixation. The catalogue
/// is data, not code — heads are created and edited from
/// `/hr/listing/salary-heads`, so a new allowance needs no deployment.
model SalaryHead {
  id           Int             @id @default(autoincrement())
  code         String          @unique
  nameEn       String
  nameBn       String
  kind         SalaryHeadKind
  basis        SalaryHeadBasis
  /// Taka amount when `basis = fixed`, whole percent when `percent_of_basic`,
  /// unused when `house_rent_rule` (the slab table supplies both).
  defaultValue Int?
  /// Pre-attached to every new fixation. An operator can still drop it from an
  /// individual employee — this only decides what the form opens with.
  isDefault    Boolean         @default(false)
  /// Retired heads stay in the table so old fixations still name them, but
  /// stop being offered on new ones.
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items          SalaryFixationItem[]
  verdictClauses VerdictClause[]

  @@index([kind, sortOrder])
}

// ─── Salary Fixation ─────────────────────────────────────────────────────────

/// One version of an employee's salary structure. The ordinary case is one per
/// fiscal year from 1 July, but an increment, a promotion or a punishment mid-
/// year raises a new version from its own effective date and marks the previous
/// one superseded. Rows are never overwritten once a month has been processed
/// against them.
model SalaryFixation {
  id           Int            @id @default(autoincrement())
  grade        Int
  /// Which rung of the grade the basic came from. Null when the basic was
  /// typed by hand — no verified scale loaded, or a deliberate override.
  step         Int?
  basicSalary  Int
  validFrom    String
  validThru    String
  salaryStatus SalaryStatus   @default(active)
  reason       FixationReason @default(annual)
  note         String?

  /// The sheet as saved. Snapshotted so that editing a head's rate, or
  /// correcting a scale, can never silently restate what an employee was
  /// actually fixed at.
  grossEarning   Int @default(0)
  totalDeduction Int @default(0)
  netSalary      Int @default(0)

  /// Set when a later version takes over. The version in force is the row with
  /// `supersededAt = null` whose date range covers today.
  supersededAt DateTime?

  createdAt DateTime @default(now())
  // `@default(now())` as well as `@updatedAt`: the 11 fixation rows that
  // predate versioning need a value for this column on backfill.
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?

  scaleId Int?
  scale   PayScale? @relation(fields: [scaleId], references: [id])

  /// Set when this version exists because of a verdict, rather than an ordinary
  /// fixation. Such a version is not editable by hand — lift the verdict.
  verdictId Int?
  verdict   CaseVerdict? @relation(fields: [verdictId], references: [id])

  /// The version this one displaced. Only set on verdict-derived versions, and
  /// only so an arrear can be worked out as `baseline.netSalary - netSalary`
  /// without replaying the whole sheet.
  baselineFixationId Int?
  baselineFixation   SalaryFixation?  @relation("FixationBaseline", fields: [baselineFixationId], references: [id])
  derivedFixations   SalaryFixation[] @relation("FixationBaseline")

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  items     SalaryFixationItem[]
  processes SalaryProcess[]

  @@index([employeeId, validFrom])
  @@index([employeeId, supersededAt])
}

/// One line of a fixation's salary sheet. `basis` and `value` are snapshotted
/// from the head at save time, so editing the head afterwards leaves settled
/// fixations alone.
model SalaryFixationItem {
  id        Int             @id @default(autoincrement())
  kind      SalaryHeadKind
  basis     SalaryHeadBasis
  /// The percent or taka figure the line was computed from. Null for
  /// `house_rent_rule`, where the slab table supplies both inputs.
  value     Int?
  amount    Int
  sortOrder Int             @default(0)

  fixationId Int
  fixation   SalaryFixation @relation(fields: [fixationId], references: [id], onDelete: Cascade)

  headId Int
  head   SalaryHead @relation(fields: [headId], references: [id])

  @@unique([fixationId, headId])
}

// ─── Case management ─────────────────────────────────────────────────────────

/// A court or departmental case against an employee. Entered only by a
/// `case_officer` or a superadmin — see `lib/salary/case-guard.ts`.
model EmployeeCase {
  id       Int        @id @default(autoincrement())
  caseNo   String     @unique
  title    String
  forum    CaseForum
  status   CaseStatus @default(open)
  filedOn  String
  summary  String?
  closedOn String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  verdicts CaseVerdict[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([status])
}

/// One verdict on a case, and the window it bites for.
///
/// Imposing a verdict raises fixation versions on its own — a punished version
/// covering the window, and a restoring version for the day after it ends — so
/// the salary chain needs no separate "is this employee punished" check.
model CaseVerdict {
  id            Int     @id @default(autoincrement())
  orderNo       String
  verdictDate   String
  effectiveFrom String
  /// Null means the punishment stands until it is revoked.
  effectiveTo   String?
  summary       String

  /// How a `basic_percent` clause treats allowances that are a percentage of
  /// basic. False (the default) computes them on the **full scale basic**, so
  /// "half the basic only, rest remains same" behaves literally. True reduces
  /// them along with the basic.
  reduceDerivedAllowances Boolean @default(false)

  /// Set when an appeal succeeds, or the order is withdrawn.
  revokedOn      String?
  revokedReason  String?
  /// Whether the revoking order also directed that withheld pay be made good.
  arrearsOrdered Boolean @default(false)

  caseId Int
  case   EmployeeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  clauses   VerdictClause[]
  fixations SalaryFixation[]
  arrears   SalaryArrear[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([caseId])
}

/// One operative clause of a verdict.
model VerdictClause {
  id    Int               @id @default(autoincrement())
  type  VerdictClauseType
  /// Increments, years, target grade or percent, depending on `type`.
  value Int?

  /// Only for `suppress_head`.
  headId Int?
  head   SalaryHead? @relation(fields: [headId], references: [id])

  verdictId Int
  verdict   CaseVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([verdictId])
}

/// Pay withheld under a verdict that a later order made good.
///
/// Computed as a difference, not by replaying history: a verdict-derived
/// fixation records the version it displaced (`baselineFixationId`), so the
/// arrear for a month is that baseline's net less what was actually paid.
/// Settled by adding it to the next month processed for the employee.
model SalaryArrear {
  id        Int    @id @default(autoincrement())
  amount    Int
  reason    String
  /// Inclusive range of months the arrear makes good, for the audit trail.
  fromMonth String
  fromYear  String
  toMonth   String
  toYear    String

  paidAt          DateTime?
  paidInProcessId Int?
  paidInProcess   SalaryProcess? @relation(fields: [paidInProcessId], references: [id])

  verdictId Int?
  verdict   CaseVerdict? @relation(fields: [verdictId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy String?
  createdAt DateTime @default(now())

  @@index([employeeId, paidAt])
}

// ─── Salary History ───────────────────────────────────────────────────────────

model SalaryHistory {
  id    Int    @id @default(autoincrement())
  sl    Int
  grade Int
  basic Int
  month String
  year  String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Salary Process ───────────────────────────────────────────────────────────

/// One employee's pay for one month, computed from the fixation in force on
/// the last day of that month. The totals are snapshotted rather than derived
/// on read, because the bank advice is generated from them and has to keep
/// showing what was actually paid.
model SalaryProcess {
  id             Int    @id @default(autoincrement())
  basicSalary    Int    @default(0)
  grossEarning   Int    @default(0)
  totalDeduction Int    @default(0)
  netSalary      Int
  issueDate      String
  month          String
  year           String

  /// Arrears settled in this month, on top of the fixation's own net.
  arrearAmount Int            @default(0)
  arrears      SalaryArrear[]

  /// The fixation version this month was paid from. Kept so a payslip can be
  /// rebuilt line by line even after a later version supersedes it.
  fixationId Int?
  fixation   SalaryFixation? @relation(fields: [fixationId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

// ─── Work History ─────────────────────────────────────────────────────────────

model WorkHistory {
  id            Int             @id @default(autoincrement())
  sl            Int
  type          WorkHistoryType @default(bsti)
  designationBn String
  designationEn String
  grade         String
  office        String
  start         String
  end           String
  orderNo       String?
  orderDate     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Education ────────────────────────────────────────────────────────────────

model Education {
  id          Int     @id @default(autoincrement())
  sl          Int
  degree      String
  subject     String?
  institution String
  board       String?
  passingYear String
  result      String?
  gpa         String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Promotion ────────────────────────────────────────────────────────────────

model Promotion {
  id            Int     @id @default(autoincrement())
  sl            Int
  designationBn String
  designationEn String
  grade         String
  effectiveDate String
  orderNo       String?
  orderDate     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Training ─────────────────────────────────────────────────────────────────

model Training {
  id          Int     @id @default(autoincrement())
  sl          Int
  title       String
  institution String?
  duration    String?
  year        String?
  result      String?
  startDate   String?
  endDate     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Foreign Training ─────────────────────────────────────────────────────────

model ForeignTraining {
  id          Int     @id @default(autoincrement())
  sl          Int
  title       String
  country     String?
  institution String?
  duration    String?
  year        String?
  result      String?
  startDate   String?
  endDate     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Publication ──────────────────────────────────────────────────────────────

model Publication {
  id          Int     @id @default(autoincrement())
  sl          Int
  type        String?
  title       String
  publisher   String?
  writers     String?
  year        String?
  description String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Award ────────────────────────────────────────────────────────────────────

model Award {
  id        Int     @id @default(autoincrement())
  sl        Int
  type      String?
  title     String
  awardedBy String?
  country   String?
  subject   String?
  reason    String?
  year      String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Bank Advice ──────────────────────────────────────────────────────────────

/// One office's salary advice to the bank for one month.
///
/// Per office, not per institute: each office pays its own staff on its own
/// cheque, and the letter names that office. A single national row could not
/// represent that — the two legacy rows were labelled Dhaka while totalling
/// every office's staff.
///
/// Once an advice exists for a month, that office's salary for it can no longer
/// be deleted and re-processed, so the stored totals and the entries computed
/// from `SalaryProcess` cannot drift apart.
model BankAdvice {
  id            Int      @id @default(autoincrement())
  memoNo        String
  month         String
  year          String
  chequeNo      String
  chequeDate    String
  depositDate   String
  totalAmount   Int
  totalInWords  String
  employeeCount Int
  createdAt     DateTime @default(now())

  /// Nullable only so the two pre-existing rows could be migrated. Every advice
  /// written from now on carries an office — the routes require it.
  officeId Int?
  office   Office? @relation(fields: [officeId], references: [id])

  @@unique([month, year, officeId])
}

// ─── Director General ──────────────────────────────────────────────────────────

model DirectorGeneral {
