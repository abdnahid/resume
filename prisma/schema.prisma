// ─── BDS Store ────────────────────────────────────────────────────────────────

enum BdsStatus {
  current
  superseded
  withdrawn
}

/// What a payment is for. The kernel payment service is shared by every module
/// (spec §1: a module that reimplements payments means the kernel is wrong), so
/// the purpose lives on the payment rather than the payment living on the thing
/// being paid for.
enum PaymentPurpose {
  bds_purchase
  application_fee
  testing_fee
  licence_fee
}

/// Where a payment has got to.
///
/// `initiated` means the payer was sent to the gateway and we are waiting.
/// Only a server-side `verify()` may move a row to `paid` — never the browser
/// coming back from a success URL, which anyone can navigate to directly.
enum PaymentStatus {
  pending
  initiated
  paid
  failed
  cancelled
  expired
  refunded
}

/// Where a CM licence application has got to (spec §5.2).
///
/// The whole machine is declared, not just the states the applicant reaches, so
/// the workflow engine has somewhere to move a file to rather than needing a
/// migration on its first day. Only `draft` → `pending_app_fee` → `submitted`
/// have transitions implemented today; everything below `submitted` is Phase 2
/// and is reached by the routing engine.
enum ApplicationState {
  draft
  pending_app_fee
  submitted
  received_by_director
  in_channel_descending
  assigned_to_fdo
  under_review
  shortfall_issued
  shortfall_responded
  review_passed
  inspection_proposed
  inspection_pending_approval
  inspection_revision_requested
  inspection_approved
  inspection_scheduled
  inspection_in_progress
  inspection_completed
  inspection_report_submitted
  test_fee_demanded
  test_fee_paid
  /// The applicant visits every destination office, so a box arriving is not
  /// the whole sample arriving. This is the state while some boxes are in and
  /// others are not; `sample_received` means the last one landed.
  sample_partially_received
  sample_received
  // Terminal and side states.
  rejected
  withdrawn
  lapsed
  inspection_failed
}

/// What kind of certification is being applied for. Only CM exists today; the
/// column is here so the kernel's application table is not CM-shaped.
enum ServiceKind {
  cm_licence
}

/// Standards division — the subject grouping the store uses as its primary
/// facet. A table rather than an enum so labels stay bilingual and a new
/// division is data entry, not a migration.
model BdsDivision {
  id        Int    @id @default(autoincrement())
  slug      String @unique
  nameEn    String
  nameBn    String
  sortOrder Int    @default(0)

  standards Bds[]
}

/// A published Bangladesh Standard, as sold by the Standards Wing.
model Bds {
  id Int @id @default(autoincrement())

  /// Canonical designation, e.g. "BDS 1982:2020". The natural key.
  number String @unique
  /// URL key derived from `number`, e.g. "bds-1982-2020".
  slug   String @unique

  titleEn String
  titleBn String?

  /// Denormalised from `number` so it sorts and filters without parsing.
  year        Int
  /// Drives the publication-date and day-wise filters. Null for older records
  /// that carry a year in the designation but no exact date on file.
  publishedOn DateTime?
  edition     String?
  pages       Int?

  /// Whole taka. The Standards Wing list price — unrelated to the service fee
  /// schedule, which moves to the kernel fee engine later.
  priceBdt Int

  status BdsStatus @default(current)

  divisionId Int
  division   BdsDivision @relation(fields: [divisionId], references: [id])

  /// A newer edition may retire several older ones, so this is many-to-one.
  supersededById Int?
  supersededBy   Bds?  @relation("Supersedes", fields: [supersededById], references: [id])
  supersedes     Bds[] @relation("Supersedes")

  /// True when this standard certifies at least one of the 315 mandatory
  /// products. Derived from `ProductStandard` by the importer rather than
  /// entered — `Product` is the list, and this is the denormalised flag the
  /// store facets and the catalogue query filter on.
  isMandatory315 Boolean @default(false)

  /// Set by the mandatory-list importer for standards that the published list
  /// names but the catalogue did not hold. Their title is the product name and
  /// their price is a stand-in, so they must not be sold as if priced.
  isFromMandatoryList Boolean @default(false)
  /// `priceBdt` is a placeholder, not the Standards Wing list price.
  priceIsPlaceholder  Boolean @default(false)

  /// Placeholder until the kernel document store exists. Real PDFs load later.
  pdfUrl String?

  /// The stored PDF, in the object store (D47). `objectKey` is the only
  /// identifier that leaves the database — a download is served by signing a
  /// short-lived URL for it *after* the purchase check, never by handing the
  /// key or a public URL to the browser.
  pdfObjectKey String?
  pdfBytes     Int?
  pdfSha256    String?

  /// Which of the 315 products this standard certifies. The join is the answer
  /// to spec §3.3 check 3 — "the BDS matches the product applied for" — now
  /// that an application names a Product rather than a standard (D44).
  testMethods       TestMethod[]
  subProducts       SubProduct[]
  refBySubParameter TestSubParameter[] @relation("SubParameterRefBds")
  standardFor       ProductStandard[]

  purchases BdsPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([divisionId])
  @@index([status])
  @@index([publishedOn])
  @@index([priceBdt])
}

// ─── Payments (kernel service) ───────────────────────────────────────────────

/// One money event, whatever module raised it.
///
/// Amounts are **integer poisha**, never taka floats: 15% VAT on a whole-taka
/// price is fractional for most prices, and a float would eventually make the
/// Income and VAT account totals disagree with what was charged.
model Payment {
  id Int @id @default(autoincrement())

  /// Human-readable, printed on the demand note and invoice. Spec §6 requires
  /// reconciliation to key on **this and nothing else** — not name, not amount,
  /// not date — because the payer may pay "from anywhere" and all three collide.
  reference String @unique

  purpose PaymentPurpose

  /// What is being paid for. Deliberately loose rather than a FK per purpose:
  /// applications, test plans and licences do not exist yet, and the payment
  /// service must not need a schema change to serve each new one.
  subjectType String
  subjectId   String

  /// The Income Fee account's share, in poisha.
  incomePoisha Int
  /// The VAT account's share, in poisha.
  vatPoisha    Int
  /// What the payer is charged. Always `income + vat` — the e-Challan splits one
  /// payment across two accounts and they have to reconcile.
  totalPoisha  Int
  /// The VAT rate used, in basis points (1500 = 15%). Snapshot, so a later rate
  /// change cannot restate a settled payment.
  vatRateBp    Int @default(1500)

  status PaymentStatus @default(pending)

  /// Which gateway handled it, so a record always says who processed the money.
  provider    String
  /// True when no real money could move. Stored rather than derived from the
  /// provider name, so a sandbox payment stays identifiable for ever.
  isSandbox   Boolean @default(false)
  /// The gateway's own transaction id.
  providerRef String?
  /// "bkash", "nagad", "visa"… as the gateway names it.
  method      String?

  /// The gateway's reported amount at settlement, kept even when it matches, so
  /// a mismatch is visible in the record rather than only in a log.
  settledPoisha Int?
  paidAt        DateTime?
  failureReason String?

  /// Who paid. Per D13 a payment always hangs off a User — an employee buying a
  /// standard is a buyer who happens to have an employee ID.
  payerUserId String
  payer       User   @relation(fields: [payerUserId], references: [id])

  /// The acting-as company, when there was one (spec §2.5 — purchases and
  /// payments are scoped to the active context).
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// Set when a standard is bought from **inside** an application (D42/D50).
  /// The purchase it grants is attached to that application automatically on
  /// fulfilment, so the applicant is not asked to do by hand the thing they
  /// just paid for. Recorded here, at the moment the payment is raised, rather
  /// than read back off the attacker-controlled return URL.
  ///
  /// Null for an ordinary store purchase: that one attaches to the buyer only,
  /// and waits until they choose an application for it.
  attachToApplicationId Int?
  attachToApplication   Application? @relation("InFlowPurchases", fields: [attachToApplicationId], references: [id])

  events   PaymentEvent[]
  purchase BdsPurchase?

  applicationFeeFor Application? @relation("ApplicationFee")

  @@index([status])
  @@index([payerUserId])
  @@index([organizationId])
  @@index([subjectType, subjectId])
}

/// Append-only audit of everything that happened to a payment.
///
/// Money needs a trail that survives the row being updated: "who says it was
/// paid, and what exactly did they say" is the question a reconciliation
/// dispute turns on.
model PaymentEvent {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// "created", "redirected", "ipn", "verified", "settled", "rejected"…
  kind   String
  /// The status the payment moved to, when this event moved it.
  status PaymentStatus?
  note   String?
  /// Whatever the gateway sent, verbatim.
  raw    Json?

  createdAt DateTime @default(now())

  @@index([paymentId])
}

/// A bought standard (spec §3.2).
model BdsPurchase {
  id Int @id @default(autoincrement())

  /// Printed on the invoice.
  purchaseNumber String @unique

  bdsId Int
  bds   Bds @relation(fields: [bdsId], references: [id])

  /// Spec §3.2 models the buyer as `buyer_type` + `buyer_id`. Deviating per
  /// D13: the buyer is always a User, and the company they were acting as (if
  /// any) is a separate nullable link. That keeps one identity across both
  /// surfaces instead of two mutually exclusive id columns.
  buyerUserId String
  buyer       User   @relation(fields: [buyerUserId], references: [id])

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  paymentId Int     @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  purchasedAt DateTime @default(now())

  /// D5 / spec §3.3 — a purchased BDS may be attached to exactly one
  /// application, ever. That rule is enforced by this being a single scalar
  /// column: a purchase points at one application or at none.
  ///
  /// **It was `@unique` until D48 and is not any more.** Uniqueness here
  /// enforced the *other* direction — one application may consume at most one
  /// purchase — which was right while a product was a single standard. A
  /// product may name several standards and an application must own all of
  /// them (D48), so an application now consumes as many purchases as its
  /// product has standards. The one-purchase-one-application rule is untouched;
  /// the layer that actually locks it is still the conditional `updateMany` in
  /// `attachBds()`, which only matches a row that is still null.
  consumedByApplicationId Int?
  consumedByApplication   Application? @relation("AttachedPurchases", fields: [consumedByApplicationId], references: [id])

  @@index([buyerUserId])
  @@index([bdsId])
  @@index([organizationId])
  @@index([consumedByApplicationId])
}

/// The sandbox gateway's own ledger.
///
/// A deliberate separate table, not a column on `Payment`. The sandbox stands in
/// for an external gateway, and the discipline being rehearsed is that a payment
/// is settled by **asking the gateway**, never by reading its own status. If the
/// sandbox recorded its outcome on the payment row, `verify()` would be circular
/// and the habit would not transfer to SSLCommerz or the e-Challan.
///
/// Nothing outside `lib/payments/sandbox.ts` may touch this table.
model SandboxGatewayTxn {
  id Int @id @default(autoincrement())

  /// The merchant reference the session was opened against.
  reference    String @unique
  /// The gateway's own id, the shape a real one would issue.
  gatewayTxnId String @unique

  amountPoisha Int
  /// "created" until the payer acts, then "paid" | "failed" | "cancelled".
  outcome      String  @default("created")
  method       String?

  /// Where the merchant asked the payer to be sent back to, and where to send
  /// them if they cancel. A real gateway is handed both at session creation and
  /// holds them for the redirect — the sandbox was taking them and discarding
  /// them, so its hosted page invented a bare return URL and dropped the `next`
  /// that carries an in-flow buyer back to their application draft.
  returnUrl String?
  cancelUrl String?

  createdAt DateTime  @default(now())
  settledAt DateTime?
}

// ─── CM licence applications ─────────────────────────────────────────────────

/// One application = one product = one factory.
///
/// Settled with the client on 2026-08-31, resolving spec §10 #1 — the decision
/// the spec flagged as carrying the highest rework cost. The licence is issued
/// to the entity that owns the factory, never to its group parent (D29).
model Application {
  id Int @id @default(autoincrement())

  /// `CM-2026-000123`. Assigned when the application is **submitted**, not when
  /// the draft is created: a number that has been quoted to an applicant should
  /// mean a file exists, and abandoned drafts would otherwise burn numbers.
  applicationNo String? @unique

  service ServiceKind      @default(cm_licence)
  state   ApplicationState @default(draft)

  /// The applicant entity. A group parent can never appear here (D29).
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// The premises the licence would cover. Its district decides the office.
  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])

  /// The office that receives the file, **snapshotted at submission** from the
  /// factory (spec §4.2 — the routing path is fixed when the file starts
  /// moving). Null while the application is still a draft.
  bstiOfficeId Int?
  bstiOffice   Office? @relation(fields: [bstiOfficeId], references: [id])

  /// The application fee. Reaching `submitted` requires it to be `paid`.
  applicationFeePaymentId Int?     @unique
  applicationFeePayment   Payment? @relation("ApplicationFee", fields: [applicationFeePaymentId], references: [id])

  /// The applicant's declaration that everything stated is true, taken at the
  /// end of the form. Stored as a time and a person, not a boolean: a consent
  /// that cannot say who gave it or when is not a declaration.
  consentAcceptedAt DateTime?
  consentAcceptedBy String?
  consenter         User?     @relation("ApplicationConsent", fields: [consentAcceptedBy], references: [id])

  submittedAt DateTime?
  createdBy   String
  creator     User      @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  documents ApplicationDocument[]
  events    ApplicationEvent[]

  /// **What the licence is applied for** (D44). The 315 mandatory products are
  /// the closed list CM works over (spec §1), and the standards the applicant
  /// must own are derived from the product rather than chosen beside it.
  ///
  /// Nullable because a draft starts before anything is chosen; required by
  /// `missingForSubmission()` well before the fee. It replaced `bdsId`, which
  /// named a single standard and could not express the 24 products whose
  /// certification needs several (D48).
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  /// The purchases attached to this file — one per standard the product names
  /// (D48), each consumed for good by being pointed here (spec §3.3). The set
  /// replaced the old single `bdsPurchaseId`, so "which standards are covered"
  /// is read off the purchases themselves rather than duplicated on both sides.
  attachedPurchases BdsPurchase[] @relation("AttachedPurchases")

  /// Payments raised for standards bought from inside this application (D50).
  /// Kept so an in-flow purchase can attach itself when it settles.
  inFlowPayments Payment[] @relation("InFlowPurchases")

  /// **Every article the licence would cover** (D51). A manufacturer applying
  /// for one product sells it in many shapes — orange 200 ml in a paper can,
  /// mango 2 L in a plastic bottle — and the licence names each. Replaced the
  /// free-text `brandName` + `productDetails` pair, which could hold the same
  /// information but not count it, group it, or carry it onto a certificate.
  /// **Who inside BSTI currently holds the file.** Null until it is submitted
  /// and the receiving office's head picks it up. This is what the applicant's
  /// stage tracker names, and spec §8 calls that most of the perceived value of
  /// the system, because it replaces a phone call.
  holderEmployeeId String?
  holder           Employee? @relation("ApplicationHolder", fields: [holderEmployeeId], references: [id])

  /// The sub-products this licence is applied for, each carrying its own
  /// variants. Replaced the flat `skus` list: the applicant now picks
  /// sub-products first, which is what makes a test plan and a fee resolvable.
  subProducts  ApplicationSubProduct[]
  consignments Consignment[]

  production ApplicationProduction?
  answers    ApplicationAnswer[]
  movements  ApplicationMovement[]

  @@index([organizationId])
  @@index([factoryId])
  @@index([productId])
  @@index([state])
  @@index([bstiOfficeId, state])
}

/// A document attached to an application.
///
/// The file itself is not stored yet — the kernel document store does not
/// exist. `storageKey` is where it will go; a row with none is a declared
/// attachment that has not been uploaded.
model ApplicationDocument {
  id Int @id @default(autoincrement())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// Which requirement this satisfies, e.g. "trade_licence", "layout_plan".
  kind       String
  label      String
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  storageKey String?

  uploadedBy String?
  uploadedAt DateTime @default(now())

  /// One document per requirement. Re-uploading replaces rather than
  /// accumulating, so a reviewing officer never has to work out which of three
  /// trade licences is the current one.
  @@unique([applicationId, kind])
  @@index([applicationId])
}

/// The movement log (spec §4.2).
///
/// Append-only. Every state change writes one, which is what lets an applicant
/// see "exactly which stage their file is at and who holds it" — the single
/// feature §8 calls most of the perceived value of the system.
model ApplicationEvent {
  id Int @id @default(autoincrement())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// The state the file moved into, when the event moved it.
  state ApplicationState?
  /// "created", "bds_attached", "fee_raised", "submitted", "forwarded"…
  kind  String
  note  String?

  /// Who acted. Null for events the system raised on its own.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([applicationId])
}

/// The five headings the published mandatory list is grouped under. A table,
/// not an enum, for the same reason `BdsDivision` is one (D7): bilingual
/// labels and ordering are data, and the CM fee schedule is expected to vary
/// by category, so a fee band will hang off this row.
model ProductCategory {
  id        Int     @id @default(autoincrement())
  /// "A".."E", exactly as the list prints it.
  letter    String  @unique
  slug      String  @unique
  nameEn    String
  nameBn    String?
  sortOrder Int     @default(0)

  products Product[]
}

/// One of the 315 products under mandatory certification.
///
/// **This table is the CM product list** (D43/D45). An application is filed
/// against a Product, and the standard it must be certified to comes from the
/// product rather than being chosen separately — which is what makes "you must
/// own the standard for the product you are applying for" checkable.
///
/// Source: `utils/mandatory list.pdf`, BSTI's published list, parsed by
/// `prisma/import/parse-mandatory-315.py` into `prisma/data/mandatory-315.json`.
/// Real data, unlike the placeholder half of the BDS catalogue.
model Product {
  id Int @id @default(autoincrement())

  /// Serial number in the published list, 1..315. The natural key: it is how
  /// BSTI's own document refers to the product.
  serial Int    @unique
  slug   String @unique

  /// The product name exactly as the list prints it.
  nameEn String
  nameBn String?

  /// The names people actually use — "Semolina" for Suji, "Mehedi" for henna,
  /// "LPG" for liquefied petroleum gas. Searched alongside the official name,
  /// because a manufacturer knows what they make, not what BSTI calls it.
  genericNames String[]

  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  /// Every row here is on the mandatory list today. The column exists because
  /// Metrology works over an open product universe (spec §1) and will add rows
  /// that are not — the flag is what keeps CM's closed list closed.
  isMandatory Boolean @default(true)

  subProducts  SubProduct[]
  standards    ProductStandard[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

/// Which standards certify a product.
///
/// Many-to-many because the list says so: 24 of the 315 name more than one
/// standard, and a multi-part standard (`BDS ISO 4427-1/-2/-3`) is several
/// catalogue rows covering one product. One is marked primary so a single
/// designation can be shown where there is only room for one.
model ProductStandard {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  bdsId Int
  bds   Bds @relation(fields: [bdsId], references: [id])

  isPrimary Boolean @default(false)
  /// The designation exactly as the mandatory list prints it, kept because it
  /// carries the amendment and revision wording the catalogue row's `number`
  /// normalises away.
  asPrinted String?

  @@id([productId, bdsId])
  @@index([bdsId])
}

/// Whether a size type is measured or chosen from a chart.
///
/// `numeric` sizes are a number and a unit — 200 ml, 250 g, 1.5 sq mm. A
/// `categorical` size has no number at all: a shirt is size M, and "M" is the
/// whole answer. Keeping them apart is what lets the form ask for a number
/// where there is one and refuse to invent one where there is not.
enum SizeKind {
  numeric
  categorical
}

/// How a product's size is expressed — weight, volume, number of items,
/// cross-section, surface area, diameter, size chart.
///
/// The applicant picks the size type first and the unit list follows from it, so
/// a biscuit cannot be measured in litres by accident. A table rather than an
/// enum (D7): the labels are bilingual, they are ordered for display, and the
/// Standards Wing will add to the list without a deployment.
///
/// **Which size types a given product may use is Phase G reference data** and
/// does not exist yet, so all of them are offered. When it lands it narrows this
/// list per product; nothing else about the model changes.
model SizeType {
  id Int @id @default(autoincrement())

  slug   String   @unique
  nameEn String
  nameBn String?
  kind   SizeKind @default(numeric)

  /// Shown under the field — "200 ml, 1.5 litre" — so the applicant can see
  /// what shape of answer is wanted before they type one.
  hintEn String?

  sortOrder Int @default(0)

  units SizeUnit[]
  skus  ApplicationSku[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// One option under a size type.
///
/// For a `numeric` type this is the unit of measure — `ml`, `kg`, `sq mm` — and
/// the SKU carries a number beside it. For a `categorical` type it is the whole
/// value: the rows under "Size chart" are `XS`, `S`, `M`, `L`, and the SKU
/// carries no number at all. One table because the applicant does the same
/// thing either way — pick a size type, then pick from its list — and two
/// tables would double the seed, the API and the form to express that.
model SizeUnit {
  id Int @id @default(autoincrement())

  sizeTypeId Int
  sizeType   SizeType @relation(fields: [sizeTypeId], references: [id], onDelete: Cascade)

  /// What is written after the number, or the categorical value itself.
  code   String
  nameEn String
  nameBn String?

  sortOrder Int @default(0)

  skus       ApplicationSku[]
  capacities ApplicationProduction[]

  @@unique([sizeTypeId, code])
  @@index([sizeTypeId])
}

/// One article the licence would cover.
///
/// A CM licence is granted for a product made at a factory, but what reaches a
/// shelf is a SKU: a brand, a flavour, a size, a pack. The spec calls the axes
/// "brand/type/size/flavour/grade" (§ wing services) and lists **inclusion** of a
/// new one as its own service — which is the strongest argument for these being
/// rows rather than a paragraph: a licence gains SKUs over its life, and each
/// addition has to be identifiable on its own.
///
/// Brand and size are required (the client's rule, 2026-09-01). Everything else
/// is optional because it does not apply to every product — cement has no
/// flavour, a biscuit has no grade.
model ApplicationSku {
  id Int @id @default(autoincrement())

  /// **The sub-product this article belongs to**, not the application.
  /// An applicant picks A1 and A3 and then names the variants under each, so a
  /// variant only means something beside the sub-product it varies.
  applicationSubProductId Int
  applicationSubProduct   ApplicationSubProduct @relation(fields: [applicationSubProductId], references: [id], onDelete: Cascade)

  /// Who put this article on the file — the applicant, or the FDO who found it
  /// at inspection.
  declaredBy DeclaredBy @default(applicant)

  /// The brand this article is sold under. Required: an unbranded SKU cannot be
  /// identified on a shelf or on a certificate. Most applications repeat one
  /// brand across every row, so the form carries the previous row's brand
  /// forward rather than asking again.
  brandName String

  /// Flavour, type or variety — "Orange", "Mango", "Whole wheat". Empty for the
  /// many products that have no variants.
  variant String?

  sizeTypeId Int
  sizeType   SizeType @relation(fields: [sizeTypeId], references: [id])

  sizeUnitId Int
  sizeUnit   SizeUnit @relation(fields: [sizeUnitId], references: [id])

  /// The number, for a `numeric` size type. Null for a `categorical` one, where
  /// `sizeUnit` carries the whole answer. `Decimal` rather than an integer
  /// because 1.5 sq mm and 0.5 L are ordinary sizes.
  sizeValue Decimal? @db.Decimal(12, 3)

  /// How the article is packed — "Paper-based can", "Plastic bottle", "PP
  /// woven sack". Free text on purpose: a packaging list across 315 products is
  /// reference data nobody has collected, and a wrong closed list would push the
  /// truth into a notes field.
  packaging String?

  /// For a multipack: how many of the above are in one sold unit — the 24 in
  /// "24 × 250 ml". Null for a single.
  unitsPerPack Int?

  /// Grade or class where the standard defines them — "Grade A", "OPC 53".
  grade String?

  /// The packaging artwork for **this article**, recorded per SKU rather than
  /// once per application: a licence covers each brand/size/flavour separately
  /// and each is sold in its own wrapper, so one label per file could only ever
  /// describe one of them.
  ///
  /// **Metadata only — the bytes are not kept.** The kernel document store does
  /// not exist yet (D47 is schema, not a client), and the screen says so rather
  /// than showing a progress bar that quietly discards the file.
  labelImageName      String?
  labelImageSizeBytes Int?
  labelImageMime      String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  registry SampleRegistration[]

  @@index([applicationSubProductId])
  @@index([sizeTypeId])
  @@index([sizeUnitId])
}

/// Who registered the plant, and therefore whose approved capacity figure the
/// applicant is quoting. A Bangladeshi manufacturer sits under one of four.
enum CapacityAuthority {
  bida // Bangladesh Investment Development Authority
  beza // Bangladesh Economic Zones Authority
  bepza // Bangladesh Export Processing Zones Authority
  bscic // Bangladesh Small and Cottage Industries Corporation
  other
}

/// What the factory can make of **this product**, and what it actually made.
///
/// On the application rather than the factory, and deliberately: one plant may
/// run several product lines, so a capacity figure is only meaningful next to
/// the product it is for. It is also a statement made on a date — a file has to
/// keep saying what was claimed when it was submitted, the same reason the
/// receiving office is snapshotted.
model ApplicationProduction {
  applicationId Int         @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  authority      CapacityAuthority
  /// The registration or approval number the capacity is quoted from. Null when
  /// the authority is `other` and the applicant has no number to give.
  registrationNo String?

  /// Approved annual capacity, in the same units the article is measured in —
  /// `SizeUnit` is reused so a capacity in litres cannot be recorded against a
  /// product sold by weight.
  annualCapacityValue Decimal  @db.Decimal(16, 3)
  capacityUnitId      Int
  capacityUnit        SizeUnit @relation(fields: [capacityUnitId], references: [id])

  /// The year being reported, as the applicant writes it — "2025-2026". Free
  /// text because Bangladesh's fiscal year and the calendar year are both in
  /// ordinary use and the form should not force a choice.
  currentYearLabel      String
  currentYearProduction Decimal @db.Decimal(16, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([capacityUnitId])
}

/// One answer to one of BSTI's questions about how the factory runs.
///
/// Rows keyed by question rather than columns, because the question set is an
/// `[ASSUMPTION]` awaiting CM Wing (the same standing as the document checklist)
/// and a set that changes must not mean a migration. `CM_QUESTIONS` in
/// `lib/cm/policy.ts` is the catalogue.
model ApplicationAnswer {
  id Int @id @default(autoincrement())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// Matches a `key` in `CM_QUESTIONS`.
  questionKey  String
  answerText   String?
  /// For a `number` question — manpower counts and the like.
  answerNumber Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([applicationId, questionKey])
  @@index([applicationId])
}

/// Which way a file moved through the organogram.
enum MovementDirection {
  /// Handed to a more junior desk for processing.
  down
  /// Sent back up, usually because the work at that desk is done.
  up
  /// Picked up by the receiving office in the first place.
  receive
}

/// Every hand-off of a file, append-only (spec §4.2).
///
/// The movement log is separate from `ApplicationEvent` because it answers a
/// different question: events say what happened to the *application*, movements
/// say who had it and when. A reviewing officer asking "how long did this sit
/// with the AD" is reading this table, and mixing it into the event stream would
/// mean parsing notes to find out.
model ApplicationMovement {
  id Int @id @default(autoincrement())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// Null on the first receipt — the file came from the applicant, not a desk.
  fromEmployeeId String?
  fromEmployee   Employee? @relation("MovementFrom", fields: [fromEmployeeId], references: [id])

  toEmployeeId String
  toEmployee   Employee @relation("MovementTo", fields: [toEmployeeId], references: [id])

  direction MovementDirection
  note      String?

  /// The staff account that moved it. Kept beside `fromEmployeeId` because a
  /// superadmin may move a file they never held.
  actorUserId String
  actor       User   @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([toEmployeeId])
}

// ─── Test parameter catalogue (Phase G) ───────────────────────────────────────
//
// The reference data behind test-plan resolution. Built from the wings' own
// parameter files — one per lab, all in the same format, the first being
// `utils/textile-parameter-list-sanitized.xlsx`.
//
// The shape is the client's, and it exists to make one class of mistake
// impossible. The same parameter name recurs across sub-products carrying a
// *different* standard limit, a different fee, or both — 94 of 181 distinct
// (parameter, sub-parameter) keys in the textile file have more than one limit.
// So a parameter is **owned by its sub-product**, never shared: two sub-products
// naming the same test are two rows, with no cell for them to collide in.
//
//   Product (one of the mandatory 315)
//     └── SubProduct           the variant the test plan resolves against
//           └── TestParameter  fee + method live here
//                 └── TestSubParameter   the result-bearing line
//
// The limit sits at the leaf: on the parameter when it has no sub-parameters,
// on the sub-parameter when it has them.

/// Which testing wing owns a test. A branch office folds its sections into one
/// lab per discipline; head office splits them (Textile, Organic Chemistry,
/// Food & Bacteriology…). The discipline is what survives that difference, and
/// it is what decides which wing supervises work sent to a third-party lab.
enum LabDiscipline {
  physical
  chemical
}

/// What kind of thing a standard limit is. A single text column cannot tell
/// these apart, and they behave differently: `declared` values are supplied by
/// the manufacturer and confirmed by the test, so they become a form field
/// rather than a pass/fail constant.
enum LimitKind {
  /// "Maximum 17%", "4 or better", "94cm (+4/ -0)cm" — an actual requirement.
  rule
  /// "As declared", "*-text field-*" — the manufacturer states the value.
  declared
  /// "As per BDS 1149" — the specification delegates to another standard.
  cross_reference
  /// Blank in the source. A gap, not a decision.
  unspecified
}

/// Where a sample is physically tested. The accountable BSTI unit is always
/// `LabRouting.labId`; this says whether the work happens there. A sample sent
/// outside stays the responsibility of the examiner who sent it, which is why
/// third-party work is a mode and not a different destination.
enum LabRoutingMode {
  in_house
  third_party
}

/// A published test procedure. Shared across parameters on purpose — a method
/// is a document, and the same one is cited by many tests. Unlike the
/// parameter, nothing about it varies by sub-product.
model TestMethod {
  id   Int    @id @default(autoincrement())
  slug String @unique

  /// The designation as the wing's file prints it, e.g. "BDS ISO 105 E 04:2016".
  designation String @unique

  /// Resolved against the catalogue where the designation names a BDS we hold.
  /// Null is ordinary — many methods cite ISO or ASTM directly.
  bdsId Int?
  bds   Bds? @relation(fields: [bdsId], references: [id])

  parameters TestParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bdsId])
}

/// A sub-product — the variant beneath a mandatory product that a test plan is
/// actually resolved against, and the level at which limits and fees differ.
///
/// The source files name a main product and a sub-product; the main product has
/// been rewritten to the mandatory-315 name, so `productId` is that row and this
/// is what hangs beneath it. 50 textile "main products" collapsed onto 17
/// products without a single collision, because the sub-product name already
/// carried what distinguished them.
model SubProduct {
  id   Int    @id @default(autoincrement())
  slug String @unique

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  nameEn String
  nameBn String?

  /// The standard designation exactly as the wing's file prints it. Kept as
  /// text because it does not always agree with the mandatory list: every
  /// textile sewing-thread package is tested against "BDS 1221 : 2011" while
  /// the published list names BDS 1221:2021 (4th Revision). Which is correct is
  /// an open question for the wing, and overwriting either answer would hide it.
  standardAsPrinted String?

  /// The catalogue row for the product's standard, when it resolves.
  bdsId Int?
  bds   Bds? @relation(fields: [bdsId], references: [id])

  /// Working days quoted for the whole package. Note these are per package and
  /// not per parameter, so a partial selection has no computable date yet.
  turnaroundNormalDays Int?
  turnaroundUrgentDays Int?

  ordinal Int @default(0)

  parameters         TestParameter[]
  applicationEntries ApplicationSubProduct[]
  labRequirements    LabSampleRequirement[]
  testOrders         LabTestOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, nameEn])
  @@index([bdsId])
}

/// One test on one sub-product. The fee and the method live here, because both
/// vary by sub-product: 8 of 71 textile parameter names run under more than one
/// method, and 3 of 88 (parameter, method) pairs carry two different fees.
model TestParameter {
  id Int @id @default(autoincrement())

  subProductId Int
  subProduct   SubProduct @relation(fields: [subProductId], references: [id], onDelete: Cascade)

  /// The parameter name as the wing's file prints it.
  nameEn String
  nameBn String?

  /// Lower-cased, whitespace-collapsed `nameEn`. **Not a foreign key** — the
  /// parameter is deliberately owned by its sub-product. This column exists so
  /// that "is this the same test as that one" stays answerable across
  /// sub-products and wings without a rename or a fuzzy match, which is what
  /// cross-wing reporting will need. Note it is not unique and must never be
  /// treated as an identity: `(labSection, slug)` is the closest thing to one,
  /// because "Moisture" in the textile file and in the food file are different
  /// tests.
  slug String

  methodId Int?
  method   TestMethod? @relation(fields: [methodId], references: [id])

  /// Integer poisha, never taka floats.
  feePoisha Int

  /// Null means the default rule applies: urgent costs twice the normal fee.
  /// A column rather than a constant because the wing says it is 2× "99.99% of
  /// the time", and the exceptions have to be recordable.
  urgentFeePoisha Int?

  /// Which wing owns this test. Comes from the file it was imported from —
  /// one file per lab — not from anything in the row itself.
  discipline LabDiscipline

  /// The lab section whose file this came from, e.g. "textile". Provenance, and
  /// the thing that makes `slug` collisions across wings readable.
  sourceSection String

  /// The standard limit, **used only when this parameter has no
  /// sub-parameters**. Where sub-parameters exist the limit belongs to each of
  /// them and this is null. Enforced by the importer.
  limitText String?
  limitKind LimitKind @default(rule)

  ordinal Int @default(0)

  subParameters TestSubParameter[]
  capabilities  LabCapability[]
  routings      LabRouting[]
  orderItems    LabTestOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subProductId, nameEn])
  @@index([slug])
  @@index([methodId])
}

/// A sub-parameter — the result-bearing line beneath a parameter. Colour
/// fastness to perspiration is one ৳700 test that produces 14 separately rated
/// readings, so the fee is charged above and the result is recorded here.
///
/// Which lines apply is decided per sub-product, never globally on the
/// parameter name: colour fastness to washing (B2) stains Acetate and Wool for
/// 14 of its 15 sub-products, and Tri-Acetate and Viscose for the fifteenth.
model TestSubParameter {
  id Int @id @default(autoincrement())

  parameterId Int
  parameter   TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  /// The sub-parameter as printed, e.g. "iv)  Acidic-Staining Nylon".
  label String

  limitText String?
  limitKind LimitKind @default(rule)

  /// Set when `limitKind` is `cross_reference` and the named standard resolves,
  /// so the delegation is a link rather than prose.
  refBdsId Int?
  refBds   Bds? @relation("SubParameterRefBds", fields: [refBdsId], references: [id])

  ordinal Int @default(0)

  results TestResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parameterId, label])
  @@index([refBdsId])
}

/// A testing laboratory. Points at the organogram unit that *is* the lab: a
/// section at head office ("Textile" under the Physical Testing Wing), or the
/// whole flat unit at a branch ("Physical Lab, Chittagong"). Both are OrgUnit
/// rows, which is what lets one model cover the two shapes.
model Lab {
  id   Int    @id @default(autoincrement())
  slug String @unique

  nameEn String
  nameBn String?

  discipline LabDiscipline

  officeId Int
  office   Office @relation(fields: [officeId], references: [id])

  /// The organogram unit this lab is. Nullable so a lab can be recorded before
  /// the organogram catches up.
  orgUnitId Int?     @unique
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id])

  isActive Boolean @default(true)

  capabilities       LabCapability[]
  routings           LabRouting[]
  consignments       Consignment[]
  testOrders         LabTestOrder[]
  sampleRequirements SampleRequirement[]
  labRequirements    LabSampleRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
  @@index([discipline])
}

/// What a lab can actually run. Sparse — only the true rows, each lab
/// maintaining its own. This is the ground truth that keeps `LabRouting` from
/// nominating a destination that cannot do the test.
model LabCapability {
  labId Int
  lab   Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  parameterId Int
  parameter   TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([labId, parameterId])
  @@index([parameterId])
}

/// The 2D map: for a sample received at this office, which lab runs this
/// parameter.
///
/// Referral is an administrative fact, not a distance calculation — Barisal may
/// send what it cannot test to Cumilla rather than to a capable Khulna — so it
/// is stored, not derived. Each office and wing maintains its own rows.
///
/// `labId` is always the **accountable BSTI unit**. When `mode` is
/// `third_party` the sample is physically tested outside, and that lab's
/// examiner selects the accredited laboratory, writes to it, and enters the
/// result. Custody never leaves BSTI even when the sample does.
model LabRouting {
  officeId Int
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  parameterId Int
  parameter   TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  labId Int
  lab   Lab @relation(fields: [labId], references: [id])

  mode LabRoutingMode @default(in_house)

  /// True while the row is the seeded stand-in rather than something an office
  /// has confirmed. Every row starts this way and the mapping module clears it,
  /// so nobody mistakes a placeholder for a decision.
  isPlaceholder Boolean @default(true)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([officeId, parameterId])
  @@index([parameterId])
  @@index([labId])
}

// ─── Samples, consignments and the CM/lab cut ─────────────────────────────────
//
// Decisions D67–D73. `lib/samples/` holds the service; `codes.ts` and `plan.ts`
// are Prisma-free (D9).
//
// **The sample changes identity at the cut.** Upstream it belongs to an
// application; downstream it is a specimen on a lab's bench. The two meet in
// exactly one row — `SampleRegistration` — so that a lab-side query on `Sample`
// or `LabTestOrder` has no path to the applicant even by accident. Neither of
// those models carries an application column: that is deliberate, not an
// oversight.
//
// **The barrier is not absolute and must not be described as if it were.** One
// database means any link is a join away for anyone who writes the join. What
// the shape buys is that the accident cannot happen and the deliberate act is
// visible: lab-facing reads go through a fixed blinded projection, and every
// re-identification is written to `Reidentification`.

/// Who put a sub-product or an article on the file. The applicant declares;
/// the FDO amends at inspection. Kept apart because "did they under-declare, or
/// did we find more" is asked in disputes, and an overwrite cannot answer it.
enum DeclaredBy {
  applicant
  fdo
}

/// Where one physical specimen is. `consumed` is ordinary, not a failure —
/// most testing destroys the sample.
enum SampleState {
  sealed
  submitted
  received_at_lab
  in_test
  consumed
  returned
  rejected
}

/// A sealed box, one per destination lab. Only the lab may open it; the
/// one-stop counts boxes and checks seals, never contents.
enum ConsignmentState {
  packed
  awaiting_submission
  submitted
  received_at_lab
  rejected
}

enum LabTestOrderState {
  awaiting_sample
  in_progress
  reported
  cancelled
}

enum TestVerdict {
  pass
  fail
  inconclusive
  not_tested
}

/// Whether a sampling-plan figure was typed by the FDO or carried forward from
/// what a lab agreed last time.
enum RequirementSource {
  entered
  learned
}

/// A sub-product on an application — what the applicant says they make, plus
/// what the FDO found.
///
/// The applicant now picks the sub-product themselves, so the fee can be quoted
/// before inspection instead of only after it. The FDO may add rows (he found
/// A2 on the floor) and each row records who put it there.
model ApplicationSubProduct {
  id Int @id @default(autoincrement())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  subProductId Int
  subProduct   SubProduct @relation(fields: [subProductId], references: [id])

  declaredBy DeclaredBy @default(applicant)

  /// The FDO who added it, when `declaredBy` is `fdo`.
  declaredByEmployeeId String?
  declaredByEmployee   Employee? @relation("SubProductDeclaredBy", fields: [declaredByEmployeeId], references: [id])

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  skus         ApplicationSku[]
  requirements SampleRequirement[]
  registry     SampleRegistration[]

  @@unique([applicationId, subProductId])
  @@index([subProductId])
}

/// How many specimens of each variant a lab needs for this sub-product on this
/// application (D69).
///
/// The **destinations are derived** from `LabRouting` — the routing map already
/// answers "received at Barisal, which labs test A1's parameters" — so the FDO
/// cannot forget one. The **count is his**, because it depends on sample
/// quantity and whether a test is destructive, which is data BSTI has not
/// collected (A§1.2). He phones the lab and types it.
model SampleRequirement {
  id Int @id @default(autoincrement())

  applicationSubProductId Int
  applicationSubProduct   ApplicationSubProduct @relation(fields: [applicationSubProductId], references: [id], onDelete: Cascade)

  labId Int
  lab   Lab @relation(fields: [labId], references: [id])

  /// Per variant, not per application: the FDO multiplies by the number of
  /// variants, and getting that arithmetic wrong is the other thing that goes
  /// wrong at inspection.
  samplesPerVariant Int

  source RequirementSource @default(entered)

  /// Who he spoke to, or why the learned default was overridden.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([applicationSubProductId, labId])
  @@index([labId])
}

/// What a lab said it needs, last time anyone asked (D69).
///
/// Written from the FDO's entry rather than by a data-entry project: the first
/// application for a sub-product costs a phone call, and every one after it
/// arrives pre-filled. The lab owns and may correct its own rows, exactly like
/// `LabCapability`.
model LabSampleRequirement {
  labId Int
  lab   Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  subProductId Int
  subProduct   SubProduct @relation(fields: [subProductId], references: [id], onDelete: Cascade)

  samplesPerVariant Int

  /// When this was last confirmed, and by whom. A stale figure should be
  /// visible as stale rather than quietly authoritative.
  agreedAt           DateTime  @default(now())
  agreedByEmployeeId String?
  agreedBy           Employee? @relation("SampleRequirementAgreedBy", fields: [agreedByEmployeeId], references: [id])

  note String?

  @@id([labId, subProductId])
  @@index([subProductId])
}

/// The sealed box. One per (application, destination lab).
///
/// **CM-side.** The FDO packs and seals it at the factory; the applicant carries
/// it to the destination office's own one-stop counter; only the lab opens it.
/// The one-stop therefore verifies the seal and the box count, never the
/// contents — which means a short consignment surfaces at the lab, days later,
/// and the letter must list seal numbers so the counter has something real to
/// check.
model Consignment {
  id Int @id @default(autoincrement())

  /// Printed on the box. Carries the destination openly — a box has to be
  /// couriered, so there is nothing to hide at this level.
  code String @unique

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// The destination lab, and therefore the office whose counter receives it.
  labId Int
  lab   Lab @relation(fields: [labId], references: [id])

  state ConsignmentState @default(packed)

  sealNo             String
  packedAt           DateTime  @default(now())
  packedByEmployeeId String?
  packedBy           Employee? @relation("ConsignmentPackedBy", fields: [packedByEmployeeId], references: [id])

  /// Handed over at the destination office's one-stop. Per box, not per
  /// application: the applicant visits every destination office, so
  /// "sample received" is several events with several dates.
  submittedAt      DateTime?
  receivedByUserId String?
  receivedBy       User?     @relation("ConsignmentReceivedBy", fields: [receivedByUserId], references: [id])

  /// Recorded by the lab when it opens the box. A broken seal is a rejection,
  /// not a note — the seal is the only thing standing between the factory and
  /// the bench while the samples are in the applicant's own custody.
  openedAt           DateTime?
  openedByEmployeeId String?
  openedBy           Employee? @relation("ConsignmentOpenedBy", fields: [openedByEmployeeId], references: [id])
  sealIntact         Boolean?
  rejectionReason    String?

  registry SampleRegistration[]
  custody  CustodyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([applicationId, labId])
  @@index([labId, state])
}

/// One physical specimen, **as the lab sees it**.
///
/// Deliberately carries no application, no consignment, no variant and no
/// brand. A lab-side query cannot reach the applicant from here, however
/// carelessly it is written. The link lives in `SampleRegistration`.
model Sample {
  id Int @id @default(autoincrement())

  /// The token printed in the QR on the jar. Belongs to neither side and is
  /// never displayed as a working identifier — a QR decodes without a session,
  /// so anything printed is readable by whoever holds the jar. It exists only
  /// to resolve at `/s/<ref>`, which answers according to who is asking.
  ref String @unique

  /// What testing-wing staff see and quote.
  labCode String @unique

  labTestOrderId Int
  labTestOrder   LabTestOrder @relation(fields: [labTestOrderId], references: [id], onDelete: Cascade)

  /// 1..N within the order — what goes on a bench sheet.
  specimenNo Int

  state SampleState @default(sealed)

  /// Condition noted when the box was opened.
  conditionNote String?

  results  TestResult[]
  registry SampleRegistration?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([labTestOrderId, specimenNo])
  @@index([state])
}

/// **The cut.** The only row where a specimen and an applicant meet.
///
/// Nothing lab-facing reads this table. `lib/samples/lab-view.ts` is the
/// projection the testing wing gets, and it never joins here; the CM side and
/// the `/s/<ref>` resolver do. Keeping it separate is what makes an accidental
/// `include` on `Sample` unable to leak an applicant.
model SampleRegistration {
  id Int @id @default(autoincrement())

  sampleId Int    @unique
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  /// What CM-side staff see and quote. Different from `labCode` so neither side
  /// holds an identifier the other recognises, and different from `ref` so
  /// neither is printed on the jar.
  cmCode String @unique

  /// Which article this specimen is — brand, size, pack.
  applicationSkuId Int
  applicationSku   ApplicationSku @relation(fields: [applicationSkuId], references: [id], onDelete: Cascade)

  applicationSubProductId Int
  applicationSubProduct   ApplicationSubProduct @relation(fields: [applicationSubProductId], references: [id], onDelete: Cascade)

  consignmentId Int
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)

  sealedAt           DateTime  @default(now())
  sealedByEmployeeId String?
  sealedBy           Employee? @relation("SampleSealedBy", fields: [sealedByEmployeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([applicationSkuId])
  @@index([applicationSubProductId])
  @@index([consignmentId])
}

/// A lab's work item: one sub-product, at one lab, with the parameters routed
/// to it.
///
/// **Carries no application.** It names the catalogue `SubProduct`, which says
/// what to test without saying who made it.
model LabTestOrder {
  id Int @id @default(autoincrement())

  code String @unique

  labId Int
  lab   Lab @relation(fields: [labId], references: [id])

  /// The catalogue row, not the application's selection of it.
  subProductId Int
  subProduct   SubProduct @relation(fields: [subProductId], references: [id])

  state LabTestOrderState @default(awaiting_sample)

  isUrgent Boolean   @default(false)
  dueOn    DateTime?

  /// Which examiner holds it. The CM side is never shown this — it sees the
  /// lab, not the person.
  holderEmployeeId String?
  holder           Employee? @relation("LabTestOrderHolder", fields: [holderEmployeeId], references: [id])

  reportedAt DateTime?

  items     LabTestOrderItem[]
  specimens Sample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([labId, state])
  @@index([subProductId])
}

/// One parameter this lab runs for this order. The set comes from `LabRouting`
/// — a lab is given its own parameters and no others.
model LabTestOrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   LabTestOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  parameterId Int
  parameter   TestParameter @relation(fields: [parameterId], references: [id])

  sortOrder Int @default(0)

  results TestResult[]

  @@unique([orderId, parameterId])
  @@index([parameterId])
}

/// A reading, per specimen, per result-bearing line.
///
/// `subParameterId` is set when the parameter has sub-parameters and null when
/// it does not — the same leaf rule the catalogue enforces (D61). Postgres
/// treats nulls as distinct, so the unique below does not constrain the
/// null case; the service checks it instead.
model TestResult {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem   LabTestOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  subParameterId Int?
  subParameter   TestSubParameter? @relation(fields: [subParameterId], references: [id])

  /// Kept as text beside the verdict. Limits are not parsed into
  /// operator/value/unit yet, so the examiner judges and the system records —
  /// a parser guessing at "from 40 to 48" fails invisibly.
  observedValue String?

  verdict TestVerdict @default(not_tested)

  enteredByEmployeeId String?
  enteredBy           Employee? @relation("TestResultEnteredBy", fields: [enteredByEmployeeId], references: [id])
  enteredAt           DateTime  @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([orderItemId, sampleId, subParameterId])
  @@index([sampleId])
  @@index([subParameterId])
}

/// Every hand-off of a box. Append-only.
model CustodyEvent {
  id Int @id @default(autoincrement())

  consignmentId Int
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)

  state ConsignmentState

  actorUserId String?
  actor       User?   @relation("CustodyActor", fields: [actorUserId], references: [id])

  note String?

  createdAt DateTime @default(now())

  @@index([consignmentId])
}

/// Every deliberate crossing of the cut.
///
/// The normal path never needs one: results come back keyed to the specimen and
/// the system re-links them. A row here means a person asked to see both sides
/// — a dispute, a retest, an investigation — and that is exactly what should
/// leave a trace.
model Reidentification {
  id Int @id @default(autoincrement())

  sampleId      Int?
  consignmentId Int?

  actorUserId String
  actor       User   @relation("ReidentificationActor", fields: [actorUserId], references: [id])

  reason String

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
}
