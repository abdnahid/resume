generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrgCategory {
  wing
  divisional
  regional
  unit
}

enum PostingStatus {
  pending
  active
}

enum PostingType {
  initial
  transfer
  promotion
  demotion
  deputation
  lien
}

enum Role {
  superadmin
  officeadmin
  /// Receives CM applications for their office and starts them moving (D57).
  /// Deliberately separate from `officeadmin`: payroll authority and
  /// file-routing authority are different jobs, and welding them together
  /// would mean whoever runs an office's salaries also decides who reviews
  /// its licence applications. Usually the senior desk in the office's
  /// Executive section, but it is a role and not a designation because when
  /// that desk is vacant a more junior officer has to act in it.
  office_head
  data_entry
  /// Handles court and departmental cases for staff across every office, and is
  /// the only role besides superadmin that may record a verdict. Carries no
  /// other administrative power.
  case_officer
  employee
  /// Inert. Clients are gated by `accountType`, not by role — this exists so a
  /// client row never reads as `employee` and trips an internal role check.
  client
}

/// Which side of the platform an account belongs to.
/// INTERNAL = BSTI staff (employee ID login, may reach internal modules).
/// CLIENT   = the public (mobile or email login, client surfaces only).
/// Defaults to INTERNAL so every pre-existing employee row stays correct.
enum AccountType {
  INTERNAL
  CLIENT
}

enum OfficeType {
  head
  divisional
  district
  regional
  dmi
}

/// What kind of employee this is, in BSTI's own terms.
///
/// Derived at import from the employee id and the pay grade, not typed in:
/// the id's middle three digits are the entry code, and code `103` is the
/// daily-basis series. Everyone else is split by grade — 1–11 officer,
/// 12–20 staff.
///
/// The id records where someone *entered*, not where they are now: three
/// code-102 staff have since been promoted into officer posts, which is why
/// grade decides officer-versus-staff and only `daily_basis` is read off the
/// code.
enum EmployeeCategory {
  /// Grades 1–11.
  officer
  /// Grades 12–20.
  staff
  /// No grade at all, and outside the national pay scale — paid under the
  /// government's daily-basis rules. Cannot hold a `SalaryFixation`.
  daily_basis
  /// Contracted through an agency. None on the roster yet.
  outsourcing
}

enum EmployeeStatus {
  active
  retired
  prl
  inactive
}

enum SalaryStatus {
  active
  expired
  not_found
  inactive
}

/// Which side of a salary sheet a head sits on.
enum SalaryHeadKind {
  earning
  deduction
}

/// How a head's amount is worked out at fixation time.
enum SalaryHeadBasis {
  /// A taka amount, taken from the head's default or overridden per employee.
  fixed
  /// A whole percent of the fixation's basic salary.
  percent_of_basic
  /// The government slab table — a percent of basic with a floor, chosen by the
  /// employee's office zone. See `HouseRentRule`.
  house_rent_rule
}

/// Why a fixation version was raised. Every version records one, so the reason
/// an employee's pay changed mid-year is on the record rather than in a note.
enum FixationReason {
  /// The 1 July fiscal-year fixation — the ordinary case.
  annual
  initial
  increment
  promotion
  punishment
  correction
}

/// Where a case is being heard.
enum CaseForum {
  departmental
  administrative_tribunal
  civil_court
  criminal_court
  high_court
  appellate_division
}

enum CaseStatus {
  open
  under_trial
  verdict_given
  under_appeal
  closed
}

/// What a verdict does to an employee's pay. Every clause is applied by
/// `applyVerdict()` in `lib/salary/compute.ts`, in the fixed order documented
/// there — order matters, since a demotion changes which grid a step reads.
enum VerdictClauseType {
  /// Move down `value` increments on the same grade. Floors at the initial step.
  reduce_increments
  /// Stay on the current step for `value` more annual fixations.
  withhold_increment
  /// Resolve basic from grade `value` instead of the substantive grade.
  demote_grade
  /// Pay `value`% of the scale basic — 50 for a half salary.
  basic_percent
  /// Every allowance falls away; deductions and basic stand.
  suppress_allowances
  /// One named head falls away. `headId` says which.
  suppress_head
}

/// Zones of the government's monthly house rent rate table.
/// Source: `utils/rent.xlsx`.
enum HouseRentZone {
  dhaka
  /// Chittagong, Khulna, Rajshahi, Sylhet, Barisal, Rangpur, Gazipur,
  /// Narayanganj — the table names these eight explicitly.
  divisional_city
  other_district
}

enum IdCardBatchStatus {
  pending
  issued
}

enum IdCardStatus {
  pending
  active
  superseded
}

enum Gender {
  male
  female
  /// A person who is neither — a real answer, not a missing one.
  other
  /// The export did not say. Distinct from `other` on purpose: guessing from a
  /// Bangladeshi name would misgender real people on their own profile, and
  /// this fills the NOT NULL without stating anything false. Paired with
  /// `Employee.identityIsProvisional`.
  unspecified
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
  /// The export did not say. See `Gender.unspecified`.
  unspecified
}

enum BloodGroup {
  A_pos
  A_neg
  B_pos
  B_neg
  AB_pos
  AB_neg
  O_pos
  O_neg
}

enum WorkHistoryType {
  bsti
  previous
}

// ─── Organogram ──────────────────────────────────────────────────────────────

model OrgUnit {
  id        Int         @id @default(autoincrement())
  slug      String      @unique
  nameEn    String
  nameBn    String
  category  OrgCategory @default(unit)
  parentId  Int?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lab      Lab?
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitTree")
  posts    OrgPost[]
}

model OrgPost {
  id              Int      @id @default(autoincrement())
  nameEn          String
  nameBn          String
  grade           String?
  sanctionedCount Int      @default(1)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unitId    Int
  unit      OrgUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employees Employee[]
  postings  Posting[]
}

model Posting {
  id           Int           @id @default(autoincrement())
  type         PostingType   @default(initial)
  status       PostingStatus @default(active)
  grade        String
  joinedAt     String?
  relievedAt   String?
  orderNo      String?
  orderDate    String?
  remarks      String?
  selfReported Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  orgPostId Int?
  orgPost   OrgPost? @relation(fields: [orgPostId], references: [id])

  officeId Int
  office   Office @relation(fields: [officeId], references: [id])
}

// ─── better-auth tables ───────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  /// Optional: a mobile-only client has no real email. better-auth's sign-up
  /// endpoint still demands one, so those rows carry a synthesised placeholder
  /// (see `lib/auth-identity.ts`) which is replaced if the client adds a real
  /// address later.
  email         String?  @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  /// Employee ID for INTERNAL accounts. Null for clients — they are keyed on
  /// `mobile` instead, which keeps an 11-digit mobile from ever colliding with
  /// an 11-digit employee ID.
  username      String?  @unique
  role          Role     @default(employee)

  accountType AccountType @default(INTERNAL)

  /// better-auth's phone-number plugin is mapped onto these two columns.
  mobile           String?   @unique
  mobileVerified   Boolean   @default(false)
  /// §2.6 — present and nullable from day one so OTP drops in without a migration.
  mobileVerifiedAt DateTime?

  sessions Session[]
  accounts Account[]
  employee Employee?

  organizationMemberships OrganizationMembership[]

  payments     Payment[]
  bdsPurchases BdsPurchase[]

  applications         Application[]
  applicationEvents    ApplicationEvent[]
  applicationConsents  Application[]         @relation("ApplicationConsent")
  applicationMovements ApplicationMovement[]

  // ─ Samples and lab testing ─
  consignmentsReceived Consignment[]      @relation("ConsignmentReceivedBy")
  custodyEvents        CustodyEvent[]     @relation("CustodyActor")
  reidentifications    Reidentification[] @relation("ReidentificationActor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ─── Office ───────────────────────────────────────────────────────────────────

model Office {
  id            Int            @id
  type          OfficeType
  nameEn        String
  nameBn        String
  /// Which column of the government house rent table this office falls in.
  /// Null means unclassified — house rent cannot be computed for its staff
  /// until someone sets it. See `npm run seed:salary`.
  houseRentZone HouseRentZone?
  officeHead    String
  addressEn     String
  addressBn     String
  phone         String?
  email         String?

  employees Employee[]
  postings  Posting[]

  bankAdvices BankAdvice[]
  bankAccount OfficeBankAccount?
  factories   Factory[]

  labs         Lab[]
  labRoutings  LabRouting[]
  applications Application[]
}

// ─── Address ──────────────────────────────────────────────────────────────────

model Address {
  id           Int     @id @default(autoincrement())
  division     String?
  district     String?
  upazila      String?
  cityCorpType String? // "cityCorp" | "pourosova" | "union"
  cityCorpName String?
  ward         String?
  houseNo      String?
  road         String?
  postOffice   String?
  postCode     String?
  thana        String?
  village      String? // legacy field — kept for backward compat

  presentOf   Employee? @relation("PresentAddress")
  permanentOf Employee? @relation("PermanentAddress")
}

// ─── Employee ─────────────────────────────────────────────────────────────────

model Employee {
  id     String         @id
  status EmployeeStatus @default(active)

  /// See `EmployeeCategory`. Defaults to `staff` only so the column could be
  /// added to existing rows; the importer sets it explicitly for everyone.
  category EmployeeCategory @default(staff)

  // Identity
  nameEn        String
  nameBn        String
  fatherNameEn  String
  fatherNameBn  String
  motherNameEn  String
  motherNameBn  String
  dateOfBirth   String
  gender        Gender
  maritalStatus MaritalStatus

  /// True when the biographical fields above are stand-ins rather than what the
  /// HR export said.
  ///
  /// 118 people were held out of the roster by five NOT NULL columns that
  /// nothing in `lib/salary/` or `lib/workflow/` reads — they are used by the
  /// profile screens and for display, and nowhere else. Keeping them out meant
  /// they had no desk, so no file could reach them, which is a working problem;
  /// a placeholder birthday is a display one. So they are admitted with
  /// stand-ins and **the stand-ins say so**, the same discipline as the seeded
  /// bank branch details and the provisional standard prices.
  ///
  /// Date of birth is derived from the joining year in the employee id. It is
  /// **not** a retirement date: `postRetirementLeave` and `fullRetirement` are
  /// stored columns and are not computed from this.
  identityIsProvisional Boolean @default(false)

  bloodGroup     BloodGroup?
  nid            String?
  passportNo     String?
  nationality    String?
  placeOfBirth   String?
  signatureLabel String?
  photoLabel     String?
  wing           String?

  // Contact
  email        String?
  mobileHome   String?
  mobileOffice String?
  phone        String?

  // Emergency contact (embedded)
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  emergencyMobile   String?

  // Bank details
  bankAccountNo String?
  bankBranch    String?
  tinNo         String?

  // Current job — nullable during Posting migration; derive from active Posting going forward
  designationEn        String?
  designationBn        String?
  grade                String?
  division             String?
  initialDesignationBn String?
  dateOfJoining        String?
  postRetirementLeave  String?
  fullRetirement       String?

  // Profile self-reporting control
  serviceHistoryLocked Boolean @default(false)

  // Profile approval workflow
  profileStatus       String    @default("draft") // draft | submitted | approved | needs_revision
  profileSubmittedAt  DateTime?
  profileApprovedAt   DateTime?
  profileApprovedBy   String?
  profileRevisionNote String?

  // Relations
  orgPostId Int?
  orgPost   OrgPost?  @relation(fields: [orgPostId], references: [id])
  postings  Posting[]

  officeId Int
  office   Office @relation(fields: [officeId], references: [id])

  presentAddressId Int?     @unique
  presentAddress   Address? @relation("PresentAddress", fields: [presentAddressId], references: [id])

  permanentAddressId Int?     @unique
  permanentAddress   Address? @relation("PermanentAddress", fields: [permanentAddressId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sub-tables
  fixations        SalaryFixation[]
  attendance       DailyAttendance[]
  cases            EmployeeCase[]
  arrears          SalaryArrear[]
  salaryHistory    SalaryHistory[]
  salaryProcesses  SalaryProcess[]
  workHistory      WorkHistory[]
  educations       Education[]
  promotions       Promotion[]
  trainings        Training[]
  foreignTrainings ForeignTraining[]
  publications     Publication[]
  awards           Award[]
  idCards          IdCard[]

  // New profile sub-tables
  spouse              Spouse?
  children            Child[]
  languages           Language[]
  curriculars         Curricular[]
  disciplinaryActions DisciplinaryAction[]
  heldApplications    Application[]         @relation("ApplicationHolder")
  movementsSent       ApplicationMovement[] @relation("MovementFrom")
  movementsReceived   ApplicationMovement[] @relation("MovementTo")

  // ─ Samples and lab testing ─
  subProductsDeclared   ApplicationSubProduct[] @relation("SubProductDeclaredBy")
  sampleRequirementsSet LabSampleRequirement[]  @relation("SampleRequirementAgreedBy")
  consignmentsPacked    Consignment[]           @relation("ConsignmentPackedBy")
  consignmentsOpened    Consignment[]           @relation("ConsignmentOpenedBy")
  samplesSealed         SampleRegistration[]    @relation("SampleSealedBy")
  labTestOrdersHeld     LabTestOrder[]          @relation("LabTestOrderHolder")
  testResultsEntered    TestResult[]            @relation("TestResultEnteredBy")
}

// ─── Pay scale (versioned) ───────────────────────────────────────────────────

/// A national pay scale. NPS-2015 is the one in force; when a new scale is
/// gazetted it arrives as another row and nothing here is ever deleted — a
/// fixation made in 2019 has to keep resolving against the scale it was made
/// under, or the salary history stops reconciling.
model PayScale {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  nameEn        String
  nameBn        String
  effectiveFrom String
  effectiveTo   String?
  /// The scale new fixations default to. Exactly one row should carry this.
  isActive      Boolean  @default(false)
  /// False until the step amounts have been loaded from the gazette and
  /// checked. Fixation refuses to derive a basic salary from an unverified
  /// scale and falls back to manual entry — see `lib/salary/compute.ts`.
  verified      Boolean  @default(false)
  incrementNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps          PayScaleStep[]
  houseRentRules HouseRentRule[]
  fixations      SalaryFixation[]

  @@index([isActive])
}

/// One cell of the scale grid: what grade G pays at step S.
/// Step 0 is the grade's initial basic; each further step is one annual
/// increment.
model PayScaleStep {
  id     Int @id @default(autoincrement())
  grade  Int
  step   Int
  amount Int

  scaleId Int
  scale   PayScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, grade, step])
  @@index([scaleId, grade])
}

/// The government's monthly house rent slabs, keyed to the scale version they
/// were published alongside. A percent of basic, floored at `minAmount`.
/// Source: `utils/rent.xlsx`.
model HouseRentRule {
  id        Int           @id @default(autoincrement())
  zone      HouseRentZone
  minBasic  Int
  /// Null means the open-ended top slab ("35501 and above").
  maxBasic  Int?
  percent   Int
  minAmount Int

  scaleId Int
  scale   PayScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, zone, minBasic])
  @@index([scaleId, zone])
}

/// Days worked in a month by one daily-basis employee.
///
/// Attendance is not payroll. Before this the day count existed only as a
/// column on `SalaryProcess`, so it came into being at the moment a month was
/// paid and could only be corrected by undoing the whole month — impossible
/// once the bank advice was issued. Here it is a record in its own right,
/// enterable through the month and correctable without touching a pay run.
///
/// Regular staff have no row here: their pay comes from a fixation.
model DailyAttendance {
  id Int @id @default(autoincrement())

  month      String
  year       String
  /// Never more than `MAX_PAID_DAYS`; the route clamps and says it did.
  daysWorked Int
  note       String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([employeeId, month, year])
  @@index([month, year])
}

/// What a daily-basis worker is paid per day, by location.
///
/// Daily-basis staff sit outside the national pay scale entirely — no grade, no
/// step, no allowances — so they cannot hold a `SalaryFixation`. Their pay is
/// simply the rate for their office's zone times the days worked.
///
/// The zones are the same three the house rent table uses, which is why this
/// keys on `HouseRentZone` rather than repeating the categories: category 1 is
/// Dhaka, 2 the divisional cities, 3 everywhere else.
///
/// Versioned by effective date rather than hung off `PayScale`, because the
/// daily rate is set by its own government order and moves independently of the
/// pay scale.
model DailyWageRate {
  id Int @id @default(autoincrement())

  zone   HouseRentZone
  /// Taka per day.
  amount Int

  effectiveFrom String
  /// Null while this is the rate in force.
  effectiveTo   String?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([zone, effectiveFrom])
  @@index([zone])
}

// ─── Salary heads ────────────────────────────────────────────────────────────

/// An allowance or deduction that can be attached to a fixation. The catalogue
/// is data, not code — heads are created and edited from
/// `/hr/listing/salary-heads`, so a new allowance needs no deployment.
model SalaryHead {
  id           Int             @id @default(autoincrement())
  code         String          @unique
  nameEn       String
  nameBn       String
  kind         SalaryHeadKind
  basis        SalaryHeadBasis
  /// Taka amount when `basis = fixed`, whole percent when `percent_of_basic`,
  /// unused when `house_rent_rule` (the slab table supplies both).
  defaultValue Int?
  /// Pre-attached to every new fixation. An operator can still drop it from an
  /// individual employee — this only decides what the form opens with.
  isDefault    Boolean         @default(false)
  /// Retired heads stay in the table so old fixations still name them, but
  /// stop being offered on new ones.
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items          SalaryFixationItem[]
  verdictClauses VerdictClause[]

  @@index([kind, sortOrder])
}

// ─── Salary Fixation ─────────────────────────────────────────────────────────

/// One version of an employee's salary structure. The ordinary case is one per
/// fiscal year from 1 July, but an increment, a promotion or a punishment mid-
/// year raises a new version from its own effective date and marks the previous
/// one superseded. Rows are never overwritten once a month has been processed
/// against them.
model SalaryFixation {
  id           Int            @id @default(autoincrement())
  grade        Int
  /// Which rung of the grade the basic came from. Null when the basic was
  /// typed by hand — no verified scale loaded, or a deliberate override.
  step         Int?
  basicSalary  Int
  validFrom    String
  validThru    String
  salaryStatus SalaryStatus   @default(active)
  reason       FixationReason @default(annual)
  note         String?

  /// The sheet as saved. Snapshotted so that editing a head's rate, or
  /// correcting a scale, can never silently restate what an employee was
  /// actually fixed at.
  grossEarning   Int @default(0)
  totalDeduction Int @default(0)
  netSalary      Int @default(0)

  /// Set when a later version takes over. The version in force is the row with
  /// `supersededAt = null` whose date range covers today.
  supersededAt DateTime?

  createdAt DateTime @default(now())
  // `@default(now())` as well as `@updatedAt`: the 11 fixation rows that
  // predate versioning need a value for this column on backfill.
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?

  scaleId Int?
  scale   PayScale? @relation(fields: [scaleId], references: [id])

  /// Set when this version exists because of a verdict, rather than an ordinary
  /// fixation. Such a version is not editable by hand — lift the verdict.
  verdictId Int?
  verdict   CaseVerdict? @relation(fields: [verdictId], references: [id])

  /// The version this one displaced. Only set on verdict-derived versions, and
  /// only so an arrear can be worked out as `baseline.netSalary - netSalary`
  /// without replaying the whole sheet.
  baselineFixationId Int?
  baselineFixation   SalaryFixation?  @relation("FixationBaseline", fields: [baselineFixationId], references: [id])
  derivedFixations   SalaryFixation[] @relation("FixationBaseline")

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  items     SalaryFixationItem[]
  processes SalaryProcess[]

  @@index([employeeId, validFrom])
  @@index([employeeId, supersededAt])
}

/// One line of a fixation's salary sheet. `basis` and `value` are snapshotted
/// from the head at save time, so editing the head afterwards leaves settled
/// fixations alone.
model SalaryFixationItem {
  id        Int             @id @default(autoincrement())
  kind      SalaryHeadKind
  basis     SalaryHeadBasis
  /// The percent or taka figure the line was computed from. Null for
  /// `house_rent_rule`, where the slab table supplies both inputs.
  value     Int?
  amount    Int
  sortOrder Int             @default(0)

  fixationId Int
  fixation   SalaryFixation @relation(fields: [fixationId], references: [id], onDelete: Cascade)

  headId Int
  head   SalaryHead @relation(fields: [headId], references: [id])

  @@unique([fixationId, headId])
}

// ─── Client parties: organizations and factories ─────────────────────────────

/// The three shapes a BSTI client takes, for CM licensing purposes.
///
/// A mother organisation with several companies under it, a company with
/// several factories, and a single factory-cum-company are all expressible
/// here: the first is a `group_parent` over `group_member`s, the other two are
/// a `standalone` with many or one factory.
enum OrganizationType {
  /// Applies in its own right and owns its factories directly.
  standalone
  /// A holding company. Administrative only — it never applies for a licence
  /// and holds no factories; its members do.
  group_parent
  /// A company under a parent. Applies, holds licences, and pays for itself.
  group_member
}

/// The progressive ladder from §2.1: a profile can be started long before it is
/// complete, and only a complete one may submit an application.
enum OrganizationStatus {
  /// Tier 2 — enough to start and save a draft application.
  draft
  /// Tier 3 — the mandatory set is present; applications may be submitted.
  complete
  /// Withdrawn or merged away. Keeps history without offering itself.
  archived
}

enum CompanyLegalForm {
  proprietorship
  partnership
  limited
  group_entity
}

/// What a member of staff may do on behalf of an organization.
enum OrganizationRole {
  /// Manages the profile, its factories and its members.
  org_admin
  /// Files and tracks applications.
  representative
  /// Read-only.
  viewer
}

/// A client company, or the parent of several.
///
/// Depth is one level by design (§2.4): a `group_member` may not itself be a
/// parent. Multi-tier holding structures are not modelled until someone
/// confirms BSTI has them.
model Organization {
  id Int @id @default(autoincrement())

  type   OrganizationType   @default(standalone)
  status OrganizationStatus @default(draft)

  nameEn    String
  nameBn    String
  legalForm CompanyLegalForm?

  /// Set only on a `group_member`.
  parentId Int?
  parent   Organization?  @relation("OrganizationGroup", fields: [parentId], references: [id])
  members  Organization[] @relation("OrganizationGroup")

  // ── Registration identifiers (§2.3) ──
  tradeLicenceNo        String?
  tradeLicenceAuthority String?
  /// Stored `DD-MM-YYYY`, like every other document date in this codebase.
  tradeLicenceExpiry    String?
  binNo                 String?
  tinNo                 String?

  // ── Registered office ──
  addressLine String?
  division    String?
  district    String?
  upazila     String?
  postCode    String?

  // ── Authorised representative ──
  repName        String?
  repDesignation String?
  repMobile      String?
  repEmail       String?
  repNid         String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  memberships OrganizationMembership[]
  factories   Factory[]
  documents   OrganizationDocument[]

  payments     Payment[]
  bdsPurchases BdsPurchase[]

  applications Application[]

  @@index([type])
  @@index([parentId])
}

/// One person's standing in one organization.
///
/// A single login may hold several — the profile switcher picks which one is
/// active, and everything is scoped to it (§2.2 path E).
model OrganizationMembership {
  id Int @id @default(autoincrement())

  role      OrganizationRole @default(representative)
  /// Which organization this user lands in when they sign in.
  isDefault Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
}

/// A premises where goods are made.
///
/// A licence is granted for a product made at a *specific* factory, which is
/// why an inspection targets a premises rather than a company — and why the
/// factory's district, not the company's, decides which BSTI office receives
/// the application.
model Factory {
  id Int @id @default(autoincrement())

  nameEn String
  nameBn String

  addressLine String
  division    String?
  /// Required, unlike every other address part: this is the field that decides
  /// which BSTI office receives applications from this factory.
  district    String
  upazila     String?
  postCode    String?

  contactName   String?
  contactMobile String?

  isActive Boolean @default(true)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The office that will receive applications from this factory. Resolved from
  /// the district when the factory is saved, and stored rather than computed at
  /// application time — a jurisdiction that is redrawn later must not silently
  /// re-route files already in flight.
  bstiOfficeId Int?
  bstiOffice   Office? @relation(fields: [bstiOfficeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applications Application[]

  @@index([organizationId])
  @@index([bstiOfficeId])
}

/// What kind of paper a client has attached to their profile.
enum OrganizationDocumentType {
  trade_licence
  bin_certificate
  tin_certificate
  incorporation
  memorandum
  representative_nid
  factory_layout
  other
}

/// A document on a company profile.
///
/// The row exists whether or not a file has been stored against it, so a
/// profile can record "trade licence no. X expiring on Y" before anyone has
/// scanned it — and the completeness rule can say which papers are still
/// missing.
model OrganizationDocument {
  id Int @id @default(autoincrement())

  type      OrganizationDocumentType
  label     String?
  /// Where the stored file lives. Null until one is uploaded.
  filePath  String?
  mimeType  String?
  sizeBytes Int?

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([organizationId, type])
}

// ─── Banking ─────────────────────────────────────────────────────────────────

/// A bank BSTI holds accounts with. Sonali Bank PLC is the only one today, but
/// the letter should not hardcode it — a change of bank is then data, not code.
model Bank {
  id        Int      @id @default(autoincrement())
  nameEn    String   @unique
  nameBn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts OfficeBankAccount[]
}

/// The account an office draws salary cheques on, and the branch its advice is
/// addressed to. One per office — that is all an advice needs.
model OfficeBankAccount {
  id Int @id @default(autoincrement())

  /// Who the letter is addressed to at the branch, e.g. সহকারী মহাব্যবস্থাপক.
  recipientDesignationBn String
  branchNameBn           String
  branchAddressBn        String
  /// The office's current account, as printed in the letter.
  accountNo              String

  /// True while the branch details are improvised rather than confirmed
  /// against the bank. The office setup screen flags these.
  isPlaceholder Boolean @default(true)

  officeId Int    @unique
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  bankId Int
  bank   Bank @relation(fields: [bankId], references: [id])

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── Case management ─────────────────────────────────────────────────────────

/// A court or departmental case against an employee. Entered only by a
/// `case_officer` or a superadmin — see `lib/salary/case-guard.ts`.
model EmployeeCase {
  id       Int        @id @default(autoincrement())
  caseNo   String     @unique
  title    String
  forum    CaseForum
  status   CaseStatus @default(open)
  filedOn  String
  summary  String?
  closedOn String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  verdicts CaseVerdict[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([status])
}

/// One verdict on a case, and the window it bites for.
///
/// Imposing a verdict raises fixation versions on its own — a punished version
/// covering the window, and a restoring version for the day after it ends — so
/// the salary chain needs no separate "is this employee punished" check.
model CaseVerdict {
  id            Int     @id @default(autoincrement())
  orderNo       String
  verdictDate   String
  effectiveFrom String
  /// Null means the punishment stands until it is revoked.
  effectiveTo   String?
  summary       String

  /// How a `basic_percent` clause treats allowances that are a percentage of
  /// basic. False (the default) computes them on the **full scale basic**, so
  /// "half the basic only, rest remains same" behaves literally. True reduces
  /// them along with the basic.
  reduceDerivedAllowances Boolean @default(false)

  /// Set when an appeal succeeds, or the order is withdrawn.
  revokedOn      String?
  revokedReason  String?
  /// Whether the revoking order also directed that withheld pay be made good.
  arrearsOrdered Boolean @default(false)

  caseId Int
  case   EmployeeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  clauses   VerdictClause[]
  fixations SalaryFixation[]
  arrears   SalaryArrear[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([caseId])
}

/// One operative clause of a verdict.
model VerdictClause {
  id    Int               @id @default(autoincrement())
  type  VerdictClauseType
  /// Increments, years, target grade or percent, depending on `type`.
  value Int?

  /// Only for `suppress_head`.
  headId Int?
  head   SalaryHead? @relation(fields: [headId], references: [id])

  verdictId Int
  verdict   CaseVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([verdictId])
}

/// Pay withheld under a verdict that a later order made good.
///
/// Computed as a difference, not by replaying history: a verdict-derived
/// fixation records the version it displaced (`baselineFixationId`), so the
/// arrear for a month is that baseline's net less what was actually paid.
/// Settled by adding it to the next month processed for the employee.
model SalaryArrear {
  id        Int    @id @default(autoincrement())
  amount    Int
  reason    String
  /// Inclusive range of months the arrear makes good, for the audit trail.
  fromMonth String
  fromYear  String
  toMonth   String
  toYear    String

  paidAt          DateTime?
  paidInProcessId Int?
  paidInProcess   SalaryProcess? @relation(fields: [paidInProcessId], references: [id])

  verdictId Int?
  verdict   CaseVerdict? @relation(fields: [verdictId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy String?
  createdAt DateTime @default(now())

  @@index([employeeId, paidAt])
}

// ─── Salary History ───────────────────────────────────────────────────────────

model SalaryHistory {
  id    Int    @id @default(autoincrement())
